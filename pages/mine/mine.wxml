<view class="page-wrap">

  <!-- 宝宝信息 -->
  <view class="card">
    <block wx:if="{{hasBaby}}">
      <view class="head-row">
        <view class="head-line">
          <text class="head-name">{{name}}</text>
          <text class="head-age">{{ageText}}</text>
        </view>
        <text class="tag tag-green" wx:if="{{stageLabel}}">{{stageLabel}}</text>
      </view>
      <view class="muted">生日 {{birthday}} · 状态：{{issueLabel}}</view>
      <view class="muted" wx:if="{{stageHint}}">{{stageHint}}</view>
    </block>
    <block wx:else>
      <view class="card-title">还没填完宝宝信息</view>
      <!-- 缺哪个由 storage.missingFields 算，页面不写死字段名 -->
      <view class="muted">{{emptyHint}}</view>
    </block>
    <button class="btn btn-ghost mt" bindtap="goProfile">{{hasBaby ? '修改宝宝档案' : '去填写'}}</button>
  </view>

  <!-- 我的记录（v2.1 升级为记录中枢）：点行展开该组食材名单，
       「有反应」单独一行 —— 数据（badFoodIds）一直在，之前只是没有行 -->
  <view class="card">
    <view class="card-title">我的记录</view>
    <view class="row row-tap {{openRow === 'safe' ? 'row-open' : ''}}"
          data-row="safe" bindtap="toggleRow">
      <text class="row-label">已吃过、没问题的食材</text>
      <view class="row-right">
        <text class="row-value">{{safeCount}} 种</text>
        <text class="link-arrow {{openRow === 'safe' ? 'link-arrow-open' : ''}}">›</text>
      </view>
    </view>
    <view class="row-detail fx-in" wx:if="{{openRow === 'safe'}}">
      <view class="rd-item" wx:for="{{safeList}}" wx:key="foodId"
            data-id="{{item.foodId}}" bindtap="goFoodDetail">
        <text class="rd-name">{{item.name}}</text>
        <text class="muted">{{item.date}} 起可吃</text>
      </view>
      <view class="muted rd-empty" wx:if="{{!safeList.length}}">还没有确认过的食材 —— 去档案页勾选（勾选 = 已经吃过、没问题），会自动记进来</view>
    </view>

    <view class="row row-tap {{openRow === 'bad' ? 'row-open' : ''}}"
          data-row="bad" bindtap="toggleRow">
      <text class="row-label">有反应、已排除的食材</text>
      <view class="row-right">
        <text class="row-value row-value-bad">{{badCount}} 种</text>
        <text class="link-arrow {{openRow === 'bad' ? 'link-arrow-open' : ''}}">›</text>
      </view>
    </view>
    <view class="row-detail fx-in" wx:if="{{openRow === 'bad'}}">
      <view class="rd-item" wx:for="{{badList}}" wx:key="foodId"
            data-id="{{item.foodId}}" bindtap="goFoodDetail">
        <text class="rd-name">{{item.name}}</text>
        <text class="muted">{{item.date}} 出现反应</text>
      </view>
      <view class="muted rd-empty" wx:if="{{!badList.length}}">没有标记过「有反应」的食材</view>
      <view class="muted rd-hint" wx:if="{{badList.length}}">已永久排除、不再排进菜单；到档案页「有反应的食材」卡里点「清除记录」可重新引入。</view>
    </view>

    <view class="row row-tap {{openRow === 'all' ? 'row-open' : ''}}"
          data-row="all" bindtap="toggleRow">
      <text class="row-label">累计记录过的食材</text>
      <view class="row-right">
        <text class="row-value">{{recordedCount}} 种</text>
        <text class="link-arrow {{openRow === 'all' ? 'link-arrow-open' : ''}}">›</text>
      </view>
    </view>
    <view class="row-detail fx-in" wx:if="{{openRow === 'all'}}">
      <view class="rd-item" wx:for="{{recordedList}}" wx:key="foodId"
            data-id="{{item.foodId}}" bindtap="goFoodDetail">
        <text class="rd-name">{{item.name}}</text>
        <text class="rd-tag rd-tag-{{item.status}}">{{item.statusLabel}}</text>
        <text class="muted">{{item.date}}</text>
      </view>
      <view class="muted rd-empty" wx:if="{{!recordedList.length}}">还没有任何记录</view>
    </view>
  </view>

  <!-- 最近 14 天喂养记录（v2.1 自档案页移来：记录归「我的」，档案页只管编辑） -->
  <view class="card">
    <view class="card-title">最近 14 天喂养记录</view>
    <view class="card-sub">首页每餐打卡后这里自动汇总，就医时把这份记录给医生看。</view>
    <view class="mh-row" wx:for="{{mealHistory}}" wx:key="key">
      <text class="mh-date">{{item.date}}</text>
      <text class="mh-name">{{item.name}}</text>
      <text class="mh-state mh-s-{{item.status}}">{{item.label}}<text wx:if="{{item.reactionName}}" class="mh-react"> · {{item.reactionName}}</text></text>
    </view>
    <view class="muted" wx:if="{{!mealHistory.length}}">还没有记录 —— 在首页给每餐打卡，这里就会有内容。</view>
  </view>

  <view class="disclaimer">
    本工具按月龄和已引入食材自动编排辅食计划，内容参考公开喂养指南整理，仅供参考，不能替代医生或注册营养师的专业意见。宝宝出现过敏、疾病或生长发育异常，请及时就医。
    {{version ? '版本 ' + version : ''}}
  </view>
</view>
