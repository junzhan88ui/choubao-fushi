<view class="page-wrap">

  <!-- 宝宝信息 -->
  <view class="card">
    <block wx:if="{{hasBaby}}">
      <view class="head-row">
        <text class="head-age">{{ageText}}</text>
        <text class="tag tag-green" wx:if="{{stageLabel}}">{{stageLabel}}</text>
      </view>
      <view class="muted">生日 {{birthday}} · 关注：{{issueLabel}}</view>
      <view class="muted" wx:if="{{stageHint}}">{{stageHint}}</view>
    </block>
    <block wx:else>
      <view class="card-title">还没填宝宝信息</view>
      <view class="muted">填完才能生成计划</view>
    </block>
    <button class="btn btn-ghost mt" bindtap="goProfile">{{hasBaby ? '修改宝宝档案' : '去填写'}}</button>
  </view>

  <!-- 我的记录 -->
  <view class="card">
    <view class="card-title">我的记录</view>
    <view class="row">
      <text class="row-label">已吃过、没问题的食材</text>
      <text class="row-value">{{safeCount}} 种</text>
    </view>
    <view class="row">
      <text class="row-label">正在观察中</text>
      <text class="row-value">{{observingCount}} 种</text>
    </view>
    <view class="row">
      <text class="row-label">累计记录过的食材</text>
      <text class="row-value">{{recordedCount}} 种</text>
    </view>
  </view>

  <!-- 内容库 -->
  <view class="card">
    <view class="card-title">内容库</view>
    <view class="row">
      <text class="row-label">食材</text>
      <text class="row-value">{{foodTotal}} 种</text>
    </view>
    <view class="row">
      <text class="row-label">菜谱</text>
      <text class="row-value">{{recipeTotal}} 道</text>
    </view>
    <view class="muted mt-sm">菜谱和食材会持续补充。内容参考公开喂养指南整理，仅供参考。</view>
  </view>

  <!-- 快捷入口 -->
  <view class="card card-tight">
    <view class="link-row" bindtap="goPlan">
      <text>查看本周计划</text>
      <text class="link-arrow">›</text>
    </view>
    <view class="link-row" bindtap="goFood">
      <text>食材查一查</text>
      <text class="link-arrow">›</text>
    </view>
  </view>

  <!-- 清除数据 -->
  <view class="card card-tight">
    <view class="link-row danger" bindtap="resetAll">
      <text>清除全部数据</text>
      <text class="link-arrow">›</text>
    </view>
  </view>

  <view class="disclaimer">
    本工具按月龄和已引入食材自动编排辅食计划，内容参考公开喂养指南整理，仅供参考，不能替代医生或注册营养师的专业意见。宝宝出现过敏、疾病或生长发育异常，请及时就医。
    {{version ? '版本 ' + version : ''}}
  </view>
</view>
