.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

/* 名称与月龄同一行：基线对齐（baseline），字号都用 --fs-lg —— 与首页同款，
   两页必须一致（原来是月龄 --fs-display 大字、名字另起一行） */
.head-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.head-name {
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--c-text);
}

.head-age {
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--c-text);
}

.mt {
  margin-top: 24rpx;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid var(--c-line);
  font-size: var(--fs-lg);
  color: var(--c-text);
}

.link-row:last-child {
  border-bottom: none;
}

.link-arrow {
  color: var(--c-text-3);
  font-size: var(--fs-title);
  line-height: 1;
}
