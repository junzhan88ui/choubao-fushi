.fd-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.fd-name {
  font-size: var(--fs-display);
  font-weight: 500;
  color: var(--c-text);
  margin-right: 16rpx;
}

.fd-sub {
  font-size: var(--fs-md);
  color: var(--c-text-3);
}

.fd-warn {
  margin-top: 16rpx;
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
  background: var(--c-amber-bg);
  border-radius: var(--r-md);
  padding: 14rpx 18rpx;
}

/* 状态 */
.fd-status {
  font-size: var(--fs-base);
  color: var(--c-text-2);
  margin-bottom: 20rpx;
}

.fd-status-val {
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: var(--r-sm);
  margin-left: 8rpx;
}

.fd-btns {
  display: flex;
  flex-wrap: wrap;
}

.mini-btn {
  font-size: var(--fs-md);
  padding: 14rpx 30rpx;
  border-radius: var(--r-pill);
  margin: 0 16rpx 16rpx 0;
}

.mini-ok {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.mini-obs {
  background: var(--c-amber-bg);
  color: var(--c-amber-ink);
}

.mini-clear {
  background: var(--c-muted);
  color: var(--c-text-2);
}

/* 引入方法 */
.fd-method {
  font-size: var(--fs-base);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-top: 16rpx;
}

.fd-note {
  font-size: var(--fs-base);
  color: var(--c-text-2);
  line-height: 1.7;
}

/* 菜谱 */
.recipe {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--c-line);
}

.recipe:first-of-type {
  border-top: none;
}

.recipe-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.recipe-name {
  font-size: var(--fs-lg);
  color: var(--c-text);
}

.recipe-meta {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
}

.meal-steps {
  margin-top: 14rpx;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 18rpx 20rpx;
}

.step {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.st-safe {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.st-observing {
  background: var(--c-amber-bg);
  color: var(--c-amber-ink);
}

.st-bad {
  background: var(--c-red-bg);
  color: var(--c-red);
}

.st-new {
  background: var(--c-muted);
  color: var(--c-text-3);
}
