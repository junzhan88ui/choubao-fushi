/* 头部：食材名 + 「类别 · 建议 N 月龄起」+ 致敏标 同排
 * 用 baseline 而不是 center —— 40rpx 标题配 26rpx 小字，基线对齐才落在同一条底线上
 * （与本页 .recipe-head 的 名称+meta 同款处理）。
 * 间距统一走 gap，不再在 .fd-name 上挂 margin-right。
 * flex-wrap 兜底：名称较长 + 致敏标时折行，避免把小字挤出屏幕。 */
.fd-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

/* 头部徽标（v2.0）：沿用全局 .food-ic 的形状，放大成视觉主角。
   .fd-title 把徽标和名称包成一组居中对齐；.fd-head 仍拿这一组的
   文字基线去和 fd-sub / 致敏标对齐 —— 原有 baseline 设计不变。 */
.fd-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.fd-ic {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--r-lg);
  font-size: 56rpx;
  margin-right: 0;
}

.fd-name {
  font-size: var(--fs-display);
  font-weight: 500;
  color: var(--c-text);
}

/* 字号保持 --fs-md 不变（与原独立成行时一致）。
   这里不再设 margin-bottom：与下方 .fd-warn 的间距由 .fd-warn 自己的
   margin-top: 16rpx 提供；无提示条时也不多出一截空白。 */
.fd-sub {
  font-size: var(--fs-md);
  color: var(--c-text-3);
}

.fd-warn {
  margin-top: 16rpx;
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
  background: var(--c-amber-bg);
  border-radius: var(--r-md);
  padding: 14rpx 18rpx;
}

/* 状态 */
.fd-status {
  font-size: var(--fs-base);
  color: var(--c-text-2);
  margin-bottom: 20rpx;
}

.fd-status-val {
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: var(--r-sm);
  margin-left: 8rpx;
}

.fd-btns {
  display: flex;
  flex-wrap: wrap;
}

.mini-btn {
  font-size: var(--fs-md);
  padding: 14rpx 30rpx;
  border-radius: var(--r-pill);
  margin: 0 16rpx 16rpx 0;
}

.mini-ok {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.mini-obs {
  background: var(--c-amber-bg);
  color: var(--c-amber-ink);
}

.mini-clear {
  background: var(--c-muted);
  color: var(--c-text-2);
}

/* 引入方法 */
.fd-method {
  font-size: var(--fs-base);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-top: 16rpx;
}

.fd-note {
  font-size: var(--fs-base);
  color: var(--c-text-2);
  line-height: 1.7;
}

/* 菜谱 */
.recipe {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--c-line);
}

.recipe:first-of-type {
  border-top: none;
}

.recipe-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.recipe-name {
  font-size: var(--fs-lg);
  color: var(--c-text);
}

.recipe-meta {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
}

.meal-steps {
  margin-top: 14rpx;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 18rpx 20rpx;
}

.step {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.st-safe {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.st-observing {
  background: var(--c-amber-bg);
  color: var(--c-amber-ink);
}

.st-bad {
  background: var(--c-red-bg);
  color: var(--c-red);
}

.st-new {
  background: var(--c-muted);
  color: var(--c-text-3);
}
