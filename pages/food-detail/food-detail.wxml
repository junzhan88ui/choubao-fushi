<view class="page-wrap" wx:if="{{food}}">

  <!-- 头部 -->
  <view class="card">
    <view class="fd-head">
      <view class="fd-title">
        <view class="food-ic fd-ic" style="background:{{iconBg}}">{{icon}}</view>
        <text class="fd-name">{{food.name}}</text>
      </view>
      <text class="fd-sub">{{food.category}} · 建议 {{food.minMonth}} 月龄起</text>
      <text class="tag tag-outline" wx:if="{{food.allergen}}">常见致敏</text>
    </view>
    <view class="fd-warn" wx:if="{{!ready}}">还没到建议月龄（{{food.minMonth}} 月龄起），先别急</view>
    <view class="fd-warn" wx:if="{{!introducible}}">这一条是禁食提示，不是待引入的辅食，不会被排进计划。</view>
  </view>

  <!-- 我的记录 -->
  <view class="card">
    <view class="card-title">我的记录</view>
    <view class="fd-status">
      <text>当前状态：</text>
      <text class="fd-status-val st-{{status}}">{{statusText}}</text>
    </view>
    <!-- v2.25：「清除记录」按钮与 clearRecord 一并移到档案页「有反应的食材」卡（bad 的另一条解除通道） -->
    <view class="fd-warn" wx:if="{{status === 'bad'}}">标记为「食物过敏」的食材不会排进食谱。重新加入食谱请点下方按钮，再按新食材少量试一次。</view>
    <view class="fd-btns">
      <!-- 已经吃过：bad 态下也显示 —— 这就是重新加入的入口（markSafe 的 bad 分支走确认弹窗，见 §6j） -->
      <view class="mini-btn mini-ok" wx:if="{{introducible && status !== 'safe'}}" bindtap="markSafe">已经吃过，没问题</view>
      <view class="mini-btn mini-bad" wx:if="{{introducible && status !== 'bad'}}" bindtap="markBad">食物过敏</view>
    </view>
  </view>

  <!-- 首次引入 -->
  <view class="card">
    <view class="card-title">第一次怎么给</view>
    <view class="row">
      <text class="row-label">建议分量</text>
      <text class="row-value">{{food.firstIntro.amount}}</text>
    </view>
    <view class="fd-method">{{food.firstIntro.method}}</view>
  </view>

  <!-- 注意事项 -->
  <view class="card" wx:if="{{food.note}}">
    <view class="card-title">要注意</view>
    <view class="fd-note">{{food.note}}</view>
  </view>

  <!-- 相关做法 -->
  <view class="card" wx:if="{{recipes.length > 0}}">
    <view class="card-title">用它能做的菜</view>
    <view class="recipe" wx:for="{{recipes}}" wx:key="id" wx:for-item="r"
          data-id="{{r.id}}" bindtap="toggleSteps">
      <view class="recipe-head">
        <text class="recipe-name">{{r.name}}</text>
        <text class="recipe-meta">{{r.texture}} · {{r.monthText}}</text>
      </view>
      <view class="meal-steps" wx:if="{{expanded === r.id}}">
        <view class="step" wx:for="{{r.steps}}" wx:key="*this" wx:for-item="s">{{s}}</view>
      </view>
    </view>
  </view>

  <view class="disclaimer">
    以上内容参考公开喂养指南整理，仅供参考，不能替代医生或注册营养师的专业意见。首次引入任何新食材都应少量开始并观察 2–3 天，出现异常立即停止并就医。
  </view>
</view>
