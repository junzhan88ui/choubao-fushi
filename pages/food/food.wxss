/* 搜索框沿用 app.wxss 的全局 .search，本页置于页面底色上，加 .search--card 变体 */

.tip-line {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  line-height: 1.7;
  padding: 0 8rpx 20rpx;
}

.tip-link {
  color: var(--c-green-dark);
  text-decoration: underline;
}

.food-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--c-line);
}

.food-row:first-of-type {
  border-top: none;
}

.food-left {
  display: flex;
  align-items: center;
}

.food-name {
  font-size: var(--fs-lg);
  color: var(--c-text);
}

/* 「敏」= 常见致敏食材，不等于危险（指南准则二：不盲目回避）。
   用中性描边标记，不用红色，避免把正常食材渲染成警示。 */
.food-flag {
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-sm);
  padding: 0 8rpx;
  margin-left: 12rpx;
}

.food-right {
  display: flex;
  align-items: center;
}

.food-month {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  margin-right: 16rpx;
}

.food-status {
  font-size: var(--fs-xs);
  padding: 4rpx 14rpx;
  border-radius: var(--r-sm);
}

.st-safe {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.st-observing {
  background: var(--c-amber-bg);
  color: var(--c-amber-ink);
}

.st-bad {
  background: var(--c-red-bg);
  color: var(--c-red);
}

.st-new {
  background: var(--c-muted);
  color: var(--c-text-3);
}
