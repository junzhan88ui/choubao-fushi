<view class="page-wrap">

  <!-- 还没建档（名称和出生日期都是必填，缺哪个由 emptyHint 说清楚） -->
  <block wx:if="{{ready && !configured}}">
    <view class="empty">
      <view class="empty-title">先填一下宝宝的信息</view>
      <view class="muted">{{emptyHint}}</view>
    </view>
    <button class="btn btn-primary" bindtap="goProfile">开始</button>
  </block>

  <block wx:if="{{ready && configured}}">

    <!-- 顶部信息（v2.7 · ③ 品牌面：与今天卡共用 --c-green-tint，全站唯一大色块）
         v2.30：右上角阶段标签（稠糊/带颗粒…）已按用户要求删除 —— 反向钉 §6t
         批⑬（用户 2026-10-16）：阶段说明行也删了，本卡不再复述阶段 —— 反向钉 §6t -->
    <view class="card card--brand">
      <!--6x-scan-start：v3.0 头卡段（§6x-11 词表只扫本段）
           批⑦（用户 2026-10-15 拍板）：占位贴纸升级为可传照片 ——
           点贴纸选一张（覆盖旧的，只存一张）、长按移除回占位；
           <image> 只绑 storage 落盘的本机路径，打包位图仍零新增
           批⑨（用户 2026-10-15 拍板）：头卡对标参考图 —— 英文小标 + 两行大标题 +
           2×2 指标格（体重/身长/本周打卡/已引入）；
           批⑫（用户 2026-10-16 拍板）：两行大标题换手写体 —— 站酷快乐体子集、
            base64 内嵌进 wxss、全程不联网；配色由品牌绿改为浅蓝 --c-hand-title。
            英文小标这一行不跟着换，仍是大字距 + 品牌深绿；
           批⑬（用户 2026-10-16 拍板）：出生日期、出生指标、状态这三行删掉，
            指标格下面那两行阶段/辅食月龄说明同批删除，反向钉在 _validate §6x-22；
            个性行（一句话描述）批⑮ 又加回来 —— 头卡 = 小标 + 两行标题 + 个性行 + 照片 + 指标格 -->
      <view class="head-row">
        <view class="head-main">
          <view class="head-kicker">my {{monthWord}} month<text class="head-star">★</text></view>
          <view class="head-line">
            <text class="head-name">{{name}}的</text>
            <text class="head-age">第{{monthNo}}个月</text>
          </view>
          <!-- 个性行（批⑬ 删、批⑮ 用户 2026-10-16 恢复）：一句话描述 ——
               档案页选填、清洗后落库，不进计划指纹 -->
          <view class="head-note" wx:if="{{noteText}}">{{noteText}}</view>
        </view>
        <view class="polaroid" bindtap="chooseBabyPhoto" longpress="removeBabyPhoto">
          <image wx:if="{{photo}}" class="polaroid-img" src="{{photo}}" mode="aspectFill" />
          <view class="polaroid-ph" wx:else>贴上宝宝的照片</view>
        </view>
      </view>
      <!-- 批⑬（用户 2026-10-16 拍板）：这一行的状态汇总删了 —— 头卡不再复述
           状态，状态仍在「我的」与档案页看得到；别加回来（§6x-22 反向钉） -->
      <view class="stat-grid">
        <view class="stat-row">
          <view class="stat-cell">
            <view class="stat-label">体重</view>
            <view class="stat-value">{{statWeight.value}}<text class="stat-unit" wx:if="{{statWeight.unit}}">{{statWeight.unit}}</text></view>
            <view class="stat-sub" wx:if="{{statWeight.sub}}">{{statWeight.sub}}</view>
          </view>
          <view class="stat-cell">
            <view class="stat-label">身长</view>
            <view class="stat-value">{{statLength.value}}<text class="stat-unit" wx:if="{{statLength.unit}}">{{statLength.unit}}</text></view>
            <view class="stat-sub" wx:if="{{statLength.sub}}">{{statLength.sub}}</view>
          </view>
        </view>
        <view class="stat-row">
          <view class="stat-cell">
            <view class="stat-label">本周打卡</view>
            <view class="stat-value">{{statCheck.value}}</view>
            <view class="stat-sub" wx:if="{{statCheck.sub}}">{{statCheck.sub}}</view>
          </view>
          <view class="stat-cell">
            <view class="stat-label">已引入</view>
            <view class="stat-value">{{statFood.value}}<text class="stat-unit" wx:if="{{statFood.unit}}">{{statFood.unit}}</text></view>
            <view class="stat-sub" wx:if="{{statFood.sub}}">{{statFood.sub}}</view>
          </view>
        </view>
      </view>
      <!--6x-scan-end -->
      <!-- 批⑬（用户 2026-10-16 拍板）：阶段说明行（stageDesc）与「辅食第 N 个月 ·
           自 X 起」副文案（foodAgeText）同批删掉 —— 这里不留兜底空壳，
           反向钉在 _validate §6t / §6w -->
      <!-- v2.31 · 提案A（用户选定）：入口是指标格下方右对齐的独立胶囊按钮 ——
           胶囊用 --r-pill 全站胶囊语言、绿底浅色（.st-safe 同系，无描边 —— 全站无硬编码
           描边色）。文案与 goMonths 接线不变（§6t 钉），别退回纯文字链接 -->
      <!-- v3.2 方案A（用户 2026-10-19 拍板）：两枚胶囊并排 —— 左「记录身高体重」
           就地弹测量面板（openMetricSheet，不跳页；档案页第 5 步已删，这里是
           唯一录入口），右仍是月龄指南。两枚都 88rpx 高，行高不变、
           首屏高度零变化。文案「滑动查看各月龄注意事项」一字未压 —— 实测两枚
           合计约 586rpx，可用 646rpx，余量足够，不需要拿可读性换位置。 -->
      <view class="head-more-row head-more-row--dual">
        <view class="head-more" bindtap="openMetricSheet"><text class="hm-plus">＋</text>记录身高体重</view>
        <view class="head-more" bindtap="goMonths">滑动查看各月龄注意事项<text class="head-more-ic">▸</text></view>
      </view>
    </view>

    <!-- 到期提醒条已删（v2.30 · 3 天观察规则整体删除）—— 别加回来，§6u 反向钉 -->

    <!-- 生病中提醒 -->
    <view class="card card-tight notice notice-sick" wx:if="{{planData.sick}}">
      <view class="notice-text">宝宝生病中：本周暂停尝试新食材，菜单已偏向易消化、营养丰富的辅食。病好后到「我的」取消勾选「生病中」，即可恢复正常饮食。</view>
      <view class="notice-btn" bindtap="goProfile">去改</view>
    </view>

    <!-- 6 月龄（满 6 不满 7）：添加要点 + 怎么做辅食。默认收起，点头部展开 -->
    <block wx:if="{{months >= 6 && months < 7}}">
      <view class="card card-guide card-guide6" wx:for="{{guide6}}" wx:key="key" wx:for-item="g">
        <view class="guide-head guide-head--tap" bindtap="toggleGuide6" data-k="{{g.key}}">
          <view class="food-ic" style="background:{{g.iconBg}}">{{g.icon}}</view>
          <view class="card-title guide-title">{{g.title}}</view>
          <!-- 文本恒为 ▸：展开态靠 .link-arrow-open 旋转 90°（换字是节点重建，做不出过渡） -->
          <text class="guide-arrow {{sixOpen[g.key] ? 'link-arrow-open' : ''}}">▸</text>
        </view>
        <view class="guide-body fx-in" wx:if="{{sixOpen[g.key]}}">
          <view class="guide-point" wx:for="{{g.points}}" wx:for-item="pt" wx:key="title">
            <view class="guide-pt-title">{{pt.title}}</view>
            <view class="guide-pt-text">{{pt.text}}</view>
          </view>
          <view class="guide-line" wx:for="{{g.lines}}" wx:for-item="line" wx:key="*this">{{line}}</view>
        </view>
      </view>
    </block>

    <!-- 7–12 月龄（v2.8 · 儿保海报融入）：分月知识卡。refresh 按月龄挑一组挂 guideLater，
         与 6 月龄卡互斥；13 月龄起挂「1 岁以上」统一卡（v2.31，guides.onePlus）；
         展开态复用 toggleGuide6/sixOpen（key 跨组唯一），默认收起点头部展开 -->
    <block wx:if="{{guideLater.length}}">
      <view class="card card-guide card-guide6" wx:for="{{guideLater}}" wx:key="key" wx:for-item="g">
        <view class="guide-head guide-head--tap" bindtap="toggleGuide6" data-k="{{g.key}}">
          <view class="food-ic" style="background:{{g.iconBg}}">{{g.icon}}</view>
          <view class="card-title guide-title">{{g.title}}</view>
          <!-- 文本恒为 ▸：展开态靠 .link-arrow-open 旋转 90°（换字是节点重建，做不出过渡） -->
          <text class="guide-arrow {{sixOpen[g.key] ? 'link-arrow-open' : ''}}">▸</text>
        </view>
        <view class="guide-body fx-in" wx:if="{{sixOpen[g.key]}}">
          <view class="guide-point" wx:for="{{g.points}}" wx:for-item="pt" wx:key="title">
            <view class="guide-pt-title">{{pt.title}}</view>
            <view class="guide-pt-text">{{pt.text}}</view>
          </view>
          <view class="guide-line" wx:for="{{g.lines}}" wx:for-item="line" wx:key="*this">{{line}}</view>
        </view>
      </view>
    </block>

    <!-- 月龄不够（<6 月龄）：铺一份「开始之前」的说明 —— 时机与风险 / 信号 / 原则 -->
    <block wx:if="{{tooYoung}}">
      <view class="empty empty-guide">
        <view class="empty-title">还没到加辅食的月龄</view>
        <view class="muted">通常满 6 个月开始。趁这段时间把下面几件事看明白，也可以先去「查一查」熟悉常见食材。</view>
      </view>

      <view class="card card-guide" wx:for="{{guide}}" wx:key="key" wx:for-item="g">
        <view class="guide-head">
          <view class="food-ic" style="background:{{g.iconBg}}">{{g.icon}}</view>
          <view class="card-title guide-title">{{g.title}}</view>
        </view>
        <view class="guide-line" wx:for="{{g.lines}}" wx:for-item="line" wx:key="*this">{{line}}</view>
      </view>
    </block>

    <!-- 超出内容覆盖范围 -->
    <block wx:if="{{outOfRange}}">
      <view class="empty">
        <view class="empty-title">宝宝已经超过 2 岁了</view>
        <view class="muted">当前版本的菜谱覆盖 6–24 月龄。这个阶段宝宝基本可以和家人一起吃饭，注意少盐少糖、切成小块就好。</view>
      </view>
    </block>

    <block wx:if="{{!tooYoung && !outOfRange && planData}}">

      <!-- 切换 -->
      <view class="seg">
        <view class="seg-item {{tab === 'plan' ? 'seg-on' : ''}}" data-tab="plan" bindtap="switchTab">本周计划</view>
        <view class="seg-item {{tab === 'shopping' ? 'seg-on' : ''}}" data-tab="shopping" bindtap="switchTab">采购清单</view>
      </view>

      <!-- 本周计划 -->
      <block wx:if="{{tab === 'plan'}}">
        <!-- 今天恒展开为主角；其余 6 天折成一行摘要，点头部展开（v2.7 · ① openDay） -->
        <view class="card day-card {{day.isToday ? 'day-card--today' : ''}}"
              wx:for="{{planData.days}}" wx:key="date" wx:for-item="day">
          <view class="day-head {{day.isToday ? '' : 'day-head--tap'}}"
                data-date="{{day.date}}" bindtap="toggleDay">
            <view class="day-head-l">
              <text class="day-week">{{day.weekday}}</text>
              <text class="day-date">{{day.dateLabel}}</text>
              <text class="day-today" wx:if="{{day.isToday}}">今天</text>
            </view>
            <!-- 折叠态 → 一行摘要（餐数 · 类数不丢，有待打卡的提示补打）；
                 展开态 → 类别覆盖（非今天时「今天」改说「当日」）。两分支必须贴在一起，
                 中间插注释会打断 wx:if/elif 链 -->
            <view class="day-peek" wx:if="{{!(day.isToday || openDay === day.date)}}">
              <text class="day-peek-sum">{{day.meals.length}} 餐 · {{day.catCount}} 类</text>
              <text class="day-peek-todo" wx:if="{{day.checkable && day.total > day.done}}">待打卡 {{day.total - day.done}}</text>
            </view>
            <view class="cat-row" wx:elif="{{day.meals.length}}">
              <text class="cat-text">{{day.isToday ? '今天' : '当日'}}覆盖 {{day.catCount}} 类食物</text>
              <text class="cat-warn" wx:if="{{day.catApplicable && !day.catOk}}">建议再补：{{day.catMissing}}</text>
            </view>
            <!-- 箭头常驻（今天除外）→ 展开/收起在同一节点上旋转才有 .18s 过渡 -->
            <text class="day-arrow {{day.isToday || openDay === day.date ? 'link-arrow-open' : ''}}"
                  wx:if="{{!day.isToday}}">▸</text>
          </view>

          <!-- 展开层：今天恒创建；非今天只在 openDay 命中时创建（fx-in 只挂用户点开的，不算入场动画） -->
          <view class="day-body {{!day.isToday && openDay === day.date ? 'fx-in' : ''}}"
                wx:if="{{day.isToday || openDay === day.date}}">
          <!-- v2.25 · 方案A：顶部独立新食材卡已移除 —— 引入都在档案页，
               计划里没有 day.newFood，这里不再兜底渲染 -->

          <!-- 时段锚点（v2.9 · 方案A）：奶 = 参考行（只标时段，不排菜不打卡）；
               正餐/加餐 = 时段头（时刻+菜名+小标签+chip 同行，整行可点展开）+ 步骤/打卡
               （样式修订：时段名不渲染，「辅食 + 奶」与上下「时段参考」右对齐；
                方案C · v2.10：时段头+观察条+步骤+打卡收进一张主餐卡） -->
          <block wx:for="{{day.timeline}}" wx:key="key" wx:for-item="row">
            <view class="milk-row" wx:if="{{row.kind === 'milk'}}">
              <text class="slot-time">{{row.time}}</text>
              <text class="milk-name">奶</text>
              <text class="milk-note">时段参考</text>
            </view>
            <block wx:else>
              <view class="meal-card">
              <view class="slot-head" data-key="{{row.meal.key}}" bindtap="toggleMeal">
                <view class="meal-main">
                  <text class="slot-time">{{row.time}}</text>
                  <text class="meal-name">{{row.meal.name}}</text>
                  <!-- v2.7：质地与类别改小标签、随菜名同行基线对齐；
                       原来那行「质地 · 克数」灰字拆掉，克数下沉到展开的步骤里。
                       样式修订：时刻与菜名同行且在前；chip 排在小标签之后；
                       时段名（上午正餐）不再渲染 -->
                  <text class="tag tag-grey meal-tag">{{row.meal.texture}}</text>
                  <text class="tag tag-grey meal-tag" wx:for="{{row.meal.cats}}" wx:key="*this">{{item}}</text>
                  <text class="slot-kind {{row.kind === 'snack' ? 'snack' : ''}}">{{row.kind === 'snack' ? '加餐' : '正餐'}}</text>
                </view>
                <text class="slot-withmilk" wx:if="{{row.withMilk}}">辅食 + 奶</text>
              </view>
              <view class="meal" data-key="{{row.meal.key}}" bindtap="toggleMeal">
                <!-- v2.25 · 方案A：餐内新食材观察条（.nfstrip）已移除 —— 观察搬进档案页 -->
                <!-- 步骤默认态：今天的餐展开（markToday 现算 meal.open），其余日子收起 -->
                <view class="meal-steps fx-in" wx:if="{{row.meal.open}}">
                  <view class="step" wx:for="{{row.meal.steps}}" wx:key="*this" wx:for-item="s">{{s}}</view>
                </view>
                <!-- 每餐打卡（v2.1）：只在日期 ≤ 今天时出现；按钮用 catchtap，
                     否则冒泡到 meal 的 bindtap=toggleMeal 会顺手展开步骤 -->
                <view class="meal-log" wx:if="{{day.checkable}}">
                  <block wx:if="{{row.meal.log}}">
                    <text class="ml-state ml-s-{{row.meal.log.status}}">已记录 · {{row.meal.log.label}}</text>
                    <text class="ml-undo" catchtap="undoMealLog"
                          data-date="{{day.date}}" data-rid="{{row.meal.recipeId}}">撤销</text>
                  </block>
                  <block wx:else>
                    <view class="ml-btn ml-btn-go" catchtap="logMeal"
                          data-date="{{day.date}}" data-rid="{{row.meal.recipeId}}" data-status="full">吃完了</view>
                    <view class="ml-btn" catchtap="logMeal"
                          data-date="{{day.date}}" data-rid="{{row.meal.recipeId}}" data-status="some">吃一些</view>
                    <view class="ml-btn" catchtap="logMeal"
                          data-date="{{day.date}}" data-rid="{{row.meal.recipeId}}" data-status="refused">没吃</view>
                  </block>
                  <!-- v2.25：「有反应」按钮已从首页餐卡删除；v2.30 档案页入口也删 ——
                       标记通道在食材详情页「食物过敏」 -->
                </view>
              </view>
              </view><!-- /meal-card（方案C：主餐成卡） -->
            </block>
          </block>

          <view class="meal-hint muted" wx:if="{{!day.meals.length}}">暂无合适的菜谱，去「我的」补一下已吃食材</view>
          </view><!-- /day-body：非今天的天到这里收拢 -->
        </view>

        <button class="btn btn-ghost" bindtap="regenerate">重新生成计划</button>
      </block>

      <!-- 采购清单 -->
      <block wx:if="{{tab === 'shopping'}}">
        <view class="card" wx:for="{{planData.shopping}}" wx:key="category" wx:for-item="group">
          <view class="card-title">{{group.category}}</view>
          <view class="row" wx:for="{{group.items}}" wx:key="foodId" wx:for-item="it">
            <view class="row-label shop-label">
              <view class="food-ic" style="background:{{it.iconBg}}">{{it.icon}}</view>
              <text>{{it.name}}</text>
            </view>
            <text class="row-value">本周 {{it.count}} 次</text>
          </view>
        </view>

        <view class="muted center shop-tip">
          共 {{planData.shoppingCount}} 种食材。宝宝每餐量很小，按出现次数估着买就行，不用买多。
        </view>

        <button class="btn btn-ghost" bindtap="regenerate">重新生成计划</button>
      </block>

    </block>

    <!-- 免责声明：所有状态都要显示，尤其是「太小」和「超范围」时 -->
    <view class="disclaimer">
      本计划由规则自动编排，内容参考公开喂养指南整理，仅供参考，不能替代医生或注册营养师的专业意见。宝宝出现过敏、疾病或生长发育异常，请及时就医。
    </view>

  </block>

  <!-- ── v3.1 首次进入弹窗（用户 2026-10-19 拍板）───────────────────────────
       触发条件 = !storage.isConfigured()（不新增「首次启动」标志位，见 index.js
       maybeOpenOnboard 的注释）。只问三件事：名字（已预填「宝贝+4位编号」）、
       出生日期（唯一必填）、首次辅食日期（选填）。
       性别/出生体重/出生身长**不进这里** —— 它们不影响排菜，放进来只会把
       首屏摩擦加回去，留给档案页第 2 步。
       点遮罩 = 跳过，与「先随便看看」同一条路（只关窗，不写持久标记）。 -->
  <view class="ob-mask" wx:if="{{obOpen}}" bindtap="skipOnboard" catchtouchmove="noop"></view>
  <view class="ob-dialog" wx:if="{{obOpen}}">
    <view class="ob-title">先认识一下宝宝</view>

    <view class="ob-name">
      <input class="ob-name-input" value="{{obName}}" maxlength="{{obNameMax}}"
             placeholder="给宝宝起个名字" placeholder-class="ob-ph"
             bindinput="onObName" />
      <text class="ob-name-tag">可改</text>
    </view>

    <picker mode="date" value="{{obBirthday}}" start="{{obMinDate}}" end="{{obToday}}"
            bindchange="onObBirthday">
      <view class="ob-row">
        <text class="ob-label">出生日期<text class="req">*</text></text>
        <text class="ob-value {{obBirthday ? '' : 'ob-value-ph'}}">{{obBirthday || '请选择'}}</text>
      </view>
    </picker>

    <!-- 选填，且只在「出生 + 4 个月 ≤ 今天」时出现：不满 4 个月没有合法值 -->
    <picker wx:if="{{obFoodReady}}" mode="date" value="{{obFoodStart || obToday}}"
            start="{{obFoodMinDate}}" end="{{obToday}}" bindchange="onObFoodStart">
      <view class="ob-row">
        <text class="ob-label">首次辅食日期<text class="ob-opt">选填</text></text>
        <text class="ob-value {{obFoodStart ? '' : 'ob-value-ph'}}">{{obFoodStart || '还没开始吃'}}</text>
      </view>
    </picker>

    <button class="btn btn-primary ob-ok" bindtap="confirmOnboard">开始用</button>
    <view class="ob-skip" bindtap="skipOnboard">先随便看看</view>
  </view>

  <!-- 身高体重记录 · 贴底面板（v3.2 从档案页搬来，用户 2026-10-19）：
       档案页第 5 步删除后，这里是唯一的录入入口。默认载入「今天」这条 ——
       今天已有记录 → 带出旧值，保存 = 覆盖今天（此时出「删除这条记录」）；
       今天没有 → 空表单新建。改「测量日期」到某条已有记录上，自动变成编辑那条。
       区间提示与标签来自 storage.GROWTH_METRICS / growth.METRICS —— 不在这写死。 -->
  <view class="sheet-mask" wx:if="{{metricOpen}}" bindtap="closeMetricSheet"
        catchtouchmove="noop"></view>
  <view class="sheet" wx:if="{{metricOpen}}">
    <view class="ms-head">
      <view class="ms-head-btn" bindtap="closeMetricSheet">取消</view>
      <view class="ms-title">{{metricHasRecord ? '编辑记录' : '记一次测量'}}</view>
      <view class="ms-save" bindtap="onMetricSave">保存</view>
    </view>
    <view class="ms-body">
      <view class="row">
        <text class="row-label">身长（cm）</text>
        <input class="row-input" type="digit" value="{{mForm.length}}" placeholder="{{ph.length}}"
               placeholder-class="row-input-ph" bindinput="onMetricInput" data-k="length" />
      </view>
      <view class="row">
        <text class="row-label">体重（kg）</text>
        <input class="row-input" type="digit" value="{{mForm.weight}}" placeholder="{{ph.weight}}"
               placeholder-class="row-input-ph" bindinput="onMetricInput" data-k="weight" />
      </view>
      <view class="row">
        <text class="row-label">头围（cm）</text>
        <input class="row-input" type="digit" value="{{mForm.head}}" placeholder="{{ph.head}}"
               placeholder-class="row-input-ph" bindinput="onMetricInput" data-k="head" />
      </view>
      <picker mode="date" value="{{mForm.date}}" start="{{mForm.minDate}}" end="{{mForm.maxDate}}"
              bindchange="onMetricDate">
        <view class="row">
          <text class="row-label">测量日期</text>
          <text class="row-value">{{mForm.date}}</text>
        </view>
      </picker>
    </view>
    <!-- 只有「当天已经有记录」时才出：删除通道必须落在用户看得见的地方 -->
    <view class="ms-del" wx:if="{{metricHasRecord}}" bindtap="onMetricDelete">删除这条记录</view>
  </view>
</view>
