/* 头卡手写体（批⑫）：站酷快乐体子集，base64 内嵌、零网络。
   文件由 scripts/gen-hand-font.py 生成，别手改；字集/体积见该脚本头注释。 */
@import "font.wxss";

/* 头卡主行（批⑨ 对标参考图）：左文字列 + 右拍立得，顶对齐（照片占右上角） */
.head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

/* 左文字列：英文小标 / 两行大标题 / 出生日期行 / 出生指标行 / 个性行。
   min-width: 0 是 flex 文本能换行的前提 —— 否则长文案把右侧照片挤出屏幕 */
.head-main {
  flex: 1;
  min-width: 0;
}

/* 英文小标（对标参考图的手写体 "my first month"）：这一行不走手写体
   （批⑫ 只有两行大标题换，见 .head-line），仍用大字距 + 品牌深绿；
   ★ 只做点缀，与绿标同色
   （#3b6d11 on 品牌浅绿 #f2f8ea ≈ 7.6:1，AA 稳过） */
.head-kicker {
  font-size: var(--fs-sm);
  color: var(--c-green-dark);
  letter-spacing: 2rpx;
}

.head-star {
  margin-left: 8rpx;
  font-size: var(--fs-base);
  color: var(--c-green-dark);
}

/* 两行大标题（批⑨ 对标参考图）：名称 + 「第 N 个月」竖排 —— 仍在同一容器、
   同一字号（§6f 钉的「名称与月龄同字号」精神不变，档位按参考图提到
   --fs-display）。原来「并到一行、用名字那档 --fs-lg」的写法见 §6f 修订行。

   批⑫（用户 2026-10-16 拍板）：两行换手写体 + 浅蓝，两项都改自批⑨拍的板：
   - 字体：站酷快乐体子集，@font-face 在本文件首行引入的 font.wxss 里
     （base64 内嵌、不上网络）。挂在本容器上，两个子元素继承。
   - 颜色：--c-hand-title 浅蓝压品牌浅绿卡面 3.9:1。标题 40rpx/600 按 WCAG
     算「大字」，过 3:1 门槛；比原来的 --c-text 深灰低不少，是「要浅蓝」的
     必然取舍（再浅一档连大字都过不了，详见 README 体积/配色表）。
   - 名字那行是用户自己填的任意字，子集覆盖 GB2312 一级 3755 字；真填了
     表外的生僻字会逐字回退 —— 字体栈里留着系统字兜底。 */
.head-line {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 4rpx;
  font-family: 'ChoubaoHand', -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

.head-name {
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--c-hand-title);
  line-height: 1.25;
}

.head-age {
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--c-hand-title);
  line-height: 1.25;
}

/* 批⑬（用户 2026-10-16 拍板）：出生日期行 / 出生指标行 / 当前状态行 / 阶段说明行 /
   辅食月龄副文案 —— 五处文案连同样式一并删除，头卡只留 小标 + 两行标题 + 个性行 +
   照片 + 2×2 指标格 + 入口胶囊。别把这几条样式加回来（§6x-22） */

/* 个性行（批⑨ 起，批⑮ 用户 2026-10-16 恢复）：用户自己的一句话 —— 是「宝宝的
   一句话」不是系统说明，所以比 .muted 大一档（--fs-md），但仍走次级灰、不上主色 */
.head-note {
  margin-top: 8rpx;
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.6;
}

/* 2×2 指标格（批⑨ 对标参考图）：白格浮在品牌浅绿面上 —— 复用卡片色/圆角，
   不引新色。两行两列用 flex 排（老 webview 也稳，不赌 flex gap / grid） */
.stat-grid {
  margin: 16rpx 0 4rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
}

.stat-row + .stat-row {
  margin-top: 12rpx;
}

.stat-cell {
  width: 48.5%;
  box-sizing: border-box;
  padding: 16rpx 18rpx;
  background: var(--c-card);
  border-radius: var(--r-md);
}

/* 格内文字层级：标签 text-3（白底 4.5+，§6x-15 现算兜底）、数值 text/600、
   单位降一档回 text-3、增量占品牌深绿（#3b6d11 on 白底 ≈ 8:1，AA 稳过） */
.stat-label {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
}

.stat-value {
  margin-top: 4rpx;
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
  line-height: 1.2;
}

.stat-unit {
  margin-left: 4rpx;
  font-size: var(--fs-sm);
  font-weight: 400;
  color: var(--c-text-3);
}

.stat-sub {
  margin-top: 2rpx;
  font-size: var(--fs-sm);
  color: var(--c-green-dark);
}

/* 独立入口行（v2.31 · 提案A，用户选定）：2×2 指标格下方右对齐的胶囊按钮 ——
   --r-pill 全站胶囊语言（与日历 chip 同系）、绿底浅色 .st-safe 同系不抢主操作
   权重、无描边（全站零硬编码描边色，token 纪律）；min-height 88rpx = 44pt 触达 */
.head-more-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.head-more {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  background: var(--c-green-bg);
  color: var(--c-green-dark);
  border-radius: var(--r-pill);
  font-size: var(--fs-sm);
  font-weight: 600;
  line-height: 1;
  /* 方案A 两枚并排后余量只剩约 60rpx：宁可整体溢出也不许换行 ——
     胶囊一旦折成两行，88rpx 的触达高度和「一行胶囊」的形态就都没了 */
  white-space: nowrap;
}

.head-more:active {
  opacity: 0.7;
  transform: scale(0.98);
}

/* v3.2 方案A（用户 2026-10-19 拍板）：两枚胶囊并排 —— 左「记录身高体重」、
   右「滑动查看各月龄注意事项」。原 .head-more-row 的 flex-end 保留不动
   （§6t 形态钉仍钉它），这里用双类选择器提高优先级覆盖成两端对齐。
   不加 flex gap：老 webview 对 gap 支持不稳（同 .stat-row 的处理）。 */
.head-more-row.head-more-row--dual {
  justify-content: space-between;
}

/* 「＋」：与右侧 ▸ 同为方向/动作提示，但分量更重一档 ——
   它是「新增一条记录」，不是「查看」，所以用正文档字号 + 品牌深绿 */
.hm-plus {
  font-size: var(--fs-base);
  color: var(--c-green-dark);
  line-height: 1;
}

/* 箭头 ▸：与知识卡 guide-arrow 同一字符族，绿色降一档只做方向提示 */
.head-more-ic {
  font-size: var(--fs-xs);
  color: var(--c-green);
}

/* 品牌面内的次级说明：--c-text-3 在浅绿上只有 4.7:1
   （AA 过线但太弱），提到 --c-text-2 = 6.0:1（v2.7 · ③）。批⑬ 之后本卡里
   已经没有 stageDesc 那一行，这条只服务卡内其余说明文字 */
.card--brand .muted {
  color: var(--c-text-2);
}

/* 提醒条 */
.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--c-amber-bg);
}

.notice-text {
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
  flex: 1;
}

.notice-btn {
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
  font-weight: 500;
  padding-left: 20rpx;
}

/* 生病中提醒条 —— 用蓝色和状态行的琥珀色区分开 */
.notice-sick {
  background: var(--c-blue-bg);
}

.notice-sick .notice-text,
.notice-sick .notice-btn {
  color: var(--c-blue);
}

/* 切换 */
.seg {
  display: flex;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: var(--fs-base);
  color: var(--c-text-2);
  padding: 16rpx 0;
  border-radius: var(--r-sm);
}

.seg-on {
  background: #ffffff;
  color: var(--c-text);
  font-weight: 500;
}

/* 天卡片 */
.day-card {
  padding: 24rpx 28rpx 12rpx;
}

/* 今天：左侧绿边 + 「今天」标签 + 日期升 display（A1，v2.2）
   padding-top 加 8rpx 留白，让这一张卡先「停」一下再进内容。
   v2.7 · ①③：加品牌浅绿整面 —— 与顶部信息卡形成「书挡」，主角靠 display
   日期与展开内容拉开层级，不靠换第二种颜色 */
.day-card--today {
  border-left: 6rpx solid var(--c-green);
  padding-left: 22rpx;
  padding-top: 32rpx;
  background: var(--c-green-tint);
}

/* 天卡片头部：左边星期+日期，右边食物覆盖数 / 折叠摘要。
   margin-left:auto 让中段（覆盖/摘要）与箭头一起靠右成组 ——
   否则 space-between 会把摘要甩到正中间 */
.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

/* baseline 而非 center：日期升到 40rpx 后，星期(30)/日期(40)/今天胶囊(22)
   三档字号按基线对齐才顺（与 .head-line 同一处理） */
.day-head-l {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.day-week {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--c-text);
  margin-right: 14rpx;
}

.day-date {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
}

/* A1（v2.2）：今天卡的日期 = 计划页唯一的 display 时刻。
   只有 --today 提档；非今天的日子保持上面的 fs-sm 灰色，全站其余安静。
   （详情页 .fd-name 也用 --fs-display —— 那是另一个页面的主角，不算冲突） */
.day-card--today .day-date {
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--c-text);
}

.day-today {
  font-size: var(--fs-xs);
  line-height: 1.4;
  color: #ffffff;
  background: var(--c-green);
  border-radius: var(--r-pill);
  padding: 2rpx 16rpx;
  margin-left: 14rpx;
}

/* 新食材 */
/* —— 折叠摘要与展开箭头（v2.7 · ①⑥）—— */

/* 非今天的头部本身是按钮：按下给反馈（同 mine 页 .row-tap 的力度） */
.day-head--tap:active {
  opacity: 0.6;
}

/* 折叠态右侧：餐数 · 类数（覆盖信息折叠后仍可见）+ 待打卡提示 */
.day-peek {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-left: auto;
  flex-shrink: 0;
  font-size: var(--fs-sm);
}

.day-peek-sum {
  color: var(--c-text-2);
}

.day-peek-todo {
  /* 白底 10:1；--c-amber 当正文 AA 不过关，一律 amber-ink */
  color: var(--c-amber-ink);
}

/* 展开箭头：节点常驻（今天除外），旋转过渡才存在；文案恒为 ▸ */
.day-arrow {
  display: inline-block;
  margin-left: 16rpx;
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  transition: transform 0.18s ease;
  flex-shrink: 0;
}

/* v2.25 · 方案A：.newfood* 卡样式已随「首页不再渲染新食材尝试」移除；
   v2.30 · 3 天观察期整体删除，档案页的观察卡也一并没了（§6u 反向钉）。 */

/* 时段锚点（v2.9 · 方案A）：时段头 = 时刻 + 菜名 + 质地/类别小标签 + 正/加餐 chip
   + 右侧奶标注，一行基线对齐（样式修订：时段名不渲染，整行可点展开） */
.slot-head {
  display: flex;
  align-items: baseline;
  column-gap: 16rpx;
  padding: 24rpx 0 4rpx;
}

.slot-time {
  font-size: var(--fs-base);
  font-weight: 600; /* 与站内字重三档一致，不引入新档 */
  color: var(--c-text);
}

.slot-kind {
  font-size: var(--fs-xs);
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.slot-kind.snack {
  background: var(--c-blue-bg);
  color: var(--c-blue);
}

.slot-withmilk {
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  white-space: nowrap;
  margin-left: auto;  /* 「辅食 + 奶」右对齐，不挤时刻与 chip */
  margin-right: 24rpx; /* 与上下奶行「时段参考」同列 —— 奶盒内边距 24rpx */
}

/* 奶参考行：只标时段，不排菜、不打卡（方案A 的视觉核心） */
.milk-row {
  display: flex;
  align-items: center;
  column-gap: 16rpx;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.milk-name {
  font-size: var(--fs-sm);
  color: var(--c-text-2);
}

.milk-note {
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  margin-left: auto;
}

/* 方案C · 主餐卡（v2.10 合并重铸）：时刻头 + 并入的观察条 + 步骤/打卡收成一张
   白卡 —— 主餐是这天的主角。横向内边距 24rpx 与奶盒内边距一致（内容列对齐）；
   卡内 .slot-withmilk 归零 —— 基础规则那 24rpx 由卡内边距接管，右缘仍与
   「时段参考」同列。白底 vs 白底靠 1rpx 描边分界（§6l：阴影只许 .card 一处，
   这里不引新阴影） */
.meal-card {
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-md);
  padding: 0 24rpx 8rpx;
  margin-top: 16rpx;
}
/* 今天：3rpx 绿边条与 day-card--today 的 6rpx 呼应 —— 今天的主餐再压一头 */
.day-card--today .meal-card {
  border-left: 3rpx solid var(--c-green);
}
.meal-card .slot-withmilk {
  margin-right: 0; /* 卡内 24rpx 已接管（基础规则保持 24rpx —— §6q 5b 钉） */
}
/* 时段头后面的餐次行：顶部分隔线由时段头的留白接管，别叠双线 */
.slot-head + .meal {
  border-top: none;
  padding-top: 8rpx;
}

/* 餐次 */
.meal {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--c-line);
}

/* 餐次行（v2.7 · ①）：菜名 + 小标签同行、基线对齐。
   原来菜名下方那行「质地 · 克数」灰字被拆掉 —— 质地与类别变成小标签随菜名，
   克数下沉到展开的步骤里逐食材写明（data/recipes.js 的 {分类} 占位符，plan.js 填数） */
.meal-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  column-gap: 10rpx;
  row-gap: 8rpx;
}

.meal-name {
  font-size: var(--fs-lg);
  font-weight: 600; /* 菜单主角（v2.7 · ② 标题档） */
  color: var(--c-text);
}

.meal-tag {
  margin: 0; /* 全局 .tag 的 margin-right/bottom 在 flex + gap 下会叠成双倍 */
}

.meal-steps {
  margin-top: 14rpx;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 18rpx 20rpx;
}

.step {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.meal-hint {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--c-line);
}

/* 每餐打卡（v2.1）：三态按钮（v2.25 起「有反应」移到档案页）。颜色全走 token */
.meal-log {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ml-btn {
  /* B2（v2.2）：打卡是 v2.1 高频主操作，命中区 ≥44pt —— 高度用 min-height
     直接表达（96rpx：iOS=48pt，Android 360dp 屏≈46dp），不靠 padding 反推
     （那依赖 line-height 1.6 永不被改）。flex 居中是配套项，否则 min-height
     会把文字顶在上边；border-box 保证 min-height 含 1rpx 边框 = 准确 96 */
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: var(--fs-sm);
  color: var(--c-text-2);
  background: var(--c-muted);
  border: 1rpx solid var(--c-line);
}

/* .ml-btn-react（有反应）已随入口移到档案页 —— 死样式删掉 */

/* 「吃完了」主操作（评审提案①）：三态同权重没有扫视落点 —— 主按钮绿化。
   底色沿用 .btn-primary 的 var(--c-green) 白字（不是新语言）；
   「吃一些 / 没吃」保持中性灰 —— 没吃不是错误，不做红。
   高度/结构仍由 .ml-btn 提供：§6l 的 min-height/flex 钉不受影响 */
.ml-btn-go {
  background: var(--c-green);
  color: #ffffff;
  border-color: transparent;
  font-weight: 500;
}

.ml-state {
  /* 与 .ml-btn 同高（96rpx）→ 打卡前后整行高度不跳。
     <text> 是 flex 行子项（已块化），垂直 padding 生效；不加 min-height：
     若基础是 content-box，min-height 会与 padding 叠加爆高。
     算术：line-height 40 + padding 28×2 = 96，两种 box-sizing 下都成立 */
  padding: 28rpx 26rpx;
  line-height: 40rpx;
  font-size: var(--fs-sm);
  color: var(--c-green-dark);
  background: var(--c-green-bg);
  border-radius: 999rpx;
}

.ml-s-refused {
  color: var(--c-text-2);
  background: var(--c-muted);
}

.ml-s-reaction {
  color: var(--c-red);
  background: var(--c-red-bg);
}

.ml-undo {
  /* 撤销也是真点击目标：与按钮同高，命中区 72×54 → 100×96（算术同 .ml-state） */
  padding: 28rpx 26rpx;
  line-height: 40rpx;
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  text-decoration: underline;
}

/* 天卡片头部右侧的食物覆盖数 —— 已并入 .day-head，不再带分隔线。
   margin-left:auto 与 .day-peek 同理：和箭头成组靠右，不被 space-between 甩到中间 */
.cat-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  font-size: var(--fs-sm);
  text-align: right;
  flex-shrink: 0;
  margin-left: auto;
}

.cat-text {
  color: var(--c-text-3);
}

.cat-warn {
  /* 琥珀文字走 amber-ink（--c-amber 当正文 AA 不过关） */
  color: var(--c-amber-ink);
}

.shop-tip {
  margin-bottom: 24rpx;
  line-height: 1.7;
}

/* 采购清单行：标签里嵌了 emoji 徽标，flex 才能和右侧次数同行 */
.shop-label {
  display: flex;
  align-items: center;
}

/* —— tooYoung 分支的「开始之前」说明（全部 <6 月龄可见）—— */
.empty-guide {
  /* 下面就要接 3 张说明卡，intro 不需要空状态那种大留白 */
  padding: 60rpx 40rpx 24rpx;
}

/* 卡头：emoji 徽标 + 标题同行。徽标是块级 view，
   不 flex 会把标题挤到下一行（同 §6g 对 .shop-label 的约束） */
.guide-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.guide-head > .card-title {
  margin-bottom: 0;
}

.guide-line {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.guide-line:last-child {
  margin-bottom: 0;
}

.empty-title {
  font-size: var(--fs-title);
  color: var(--c-text);
  font-weight: 600;
  margin-bottom: 14rpx;
}

/* —— 6 月龄说明卡（添加要点 / 怎么做辅食）：默认收起，点头部展开 —— */
.guide-head--tap {
  /* 头部本身就是按钮，收起时是卡片最后一行 —— 间距交给 .guide-body 负责 */
  margin-bottom: 0;
}

.guide-arrow {
  /* 推到最右（flex 行里 margin-left:auto），提示可点开。
     v2.7 · ⑥：文案恒为 ▸，展开态靠 .link-arrow-open 旋转 90° ——
     在 ▸/▾ 之间换字是节点重建，没有过渡可言；旋转必须挂在常驻节点上 */
  margin-left: auto;
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  padding-left: 16rpx;
  display: inline-block;
  transition: transform 0.18s ease;
}

.guide-body {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--c-line);
  padding-top: 16rpx;
}

.guide-pt-title {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-text);
  margin-bottom: 6rpx;
}

.guide-pt-text {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 16rpx;
  /* 文案里的 \n 要真换行（第一口辅食、观察过敏是分行写法） */
  white-space: pre-line;
}

.guide-point:last-child .guide-pt-text {
  margin-bottom: 0;
}

/* —— v3.0 · 首页头卡新增两件（§6x-14/15 钉）—— */

/* 拍立得贴纸：3° 白框 + 虚线内边 + 灰字（决策① · 2026-10-15 修订为真照片：
   批⑦ 接 chooseMedia，点贴纸传一张、长按移除；照片经 <image> 渲染，
   本体仍是纯 CSS —— 零打包位图、零 CSS 位图，虚线用 --c-text-3 token
   （全站零硬编码描边色纪律，§6v/§6g 同款）） */
.polaroid {
  flex-shrink: 0;
  width: 172rpx;
  padding: 14rpx 14rpx 32rpx;
  background: var(--c-card);
  border-radius: var(--r-sm);
  transform: rotate(3deg);
}

/* 真照片（批⑦）：贴纸内框定高裁切 —— aspectFill 保比例填满不拉伸，
   圆角贴合白框；没传照片时 wx:else 仍走 .polaroid-ph 占位 */
.polaroid-img {
  display: block;
  width: 100%;
  height: 176rpx;
  border-radius: var(--r-sm);
}

.polaroid-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  padding: 8rpx;
  border: 2rpx dashed var(--c-text-3);
  border-radius: var(--r-sm);
  text-align: center;
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  line-height: 1.5;
}

/* 批⑬（用户 2026-10-16 拍板）：出生指标行「出生 6.6kg · 56cm」连同 .head-birth
   一并删除 —— 档案页的出生体重/身长还在（指标格的 Δ 要用），只是首页不显示了 */

/* ── v3.1 首次进入弹窗（用户 2026-10-19 拍板）─────────────────────────────
   名字预填「宝贝+4位编号」（可改），出生日期是唯一必填，辅食日期选填。
   遮罩与卡片都是 fixed —— 首页内容再长也不会把它顶偏。
   层级 900/901：高于页面内一切，低于微信原生弹层。 */
.ob-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(30, 29, 25, 0.42);
  z-index: 900;
}

.ob-dialog {
  position: fixed;
  top: 50%;
  left: 50rpx;
  right: 50rpx;
  z-index: 901;
  transform: translateY(-50%);
  padding: 44rpx 36rpx 28rpx;
  background: var(--c-card);
  border-radius: var(--r-card);
  box-shadow: 0 24rpx 64rpx -16rpx rgba(0, 0, 0, 0.3);
}

.ob-title {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
}

/* 名字：这一格是弹窗的视觉主体，给品牌浅绿底 + 深绿字，
   与首页头卡同一块色（--c-green-tint），用户一眼知道「这是我的宝宝」 */
.ob-name {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  background: var(--c-green-tint);
  border-radius: var(--r-md);
}

.ob-name-input {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--c-green-dark);
  letter-spacing: 1rpx;
}

.ob-ph {
  font-size: var(--fs-base);
  font-weight: 400;
  color: var(--c-text-3);
  letter-spacing: 0;
}

.ob-name-tag {
  flex: none;
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  font-size: var(--fs-xs);
  color: var(--c-green);
  background: var(--c-card);
  border: 1rpx solid #d9e6c6;
  border-radius: var(--r-pill);
}

.ob-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid var(--c-line);
}

.ob-label {
  font-size: var(--fs-base);
  color: var(--c-text-2);
}

/* 星号：与档案页 .req 同一套（页面样式不跨页，两处各留一份） */
.ob-label .req {
  margin-left: 6rpx;
  color: var(--c-red);
}

.ob-opt {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  background: var(--c-muted);
  border-radius: var(--r-sm);
}

.ob-value {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-text);
}

.ob-value-ph {
  font-weight: 400;
  color: var(--c-text-3);
}

.ob-ok {
  margin-top: 36rpx;
}

.ob-skip {
  padding: 22rpx 0 4rpx;
  font-size: var(--fs-md);
  color: var(--c-text-3);
  text-align: center;
}

/* ── 身高体重记录面板（v3.2 从档案页搬来，用户 2026-10-19）────────────────
   版式沿用原档案页那一版：顶栏「取消 / 标题 / 保存」→ 四行输入 → 删除通道。
   .sheet / .sheet-mask / .row-input 已在 app.wxss（与档案页辅食面板共用），
   这里只放这块面板自己的零件。 */
.ms-head {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid var(--c-line);
}

.ms-head-btn,
.ms-save {
  padding: 8rpx 0;
  font-size: var(--fs-base);
}

.ms-head-btn {
  color: var(--c-text-2);
}

/* 标题居中：两侧按钮宽度不等（取消 2 字 / 保存 2 字，实际等宽），
   用 flex:1 + 居中而不是绝对定位 —— 汉字字数变了也不会偏 */
.ms-title {
  flex: 1;
  text-align: center;
  font-size: var(--fs-base);
  font-weight: 600;
  color: var(--c-text);
}

.ms-save {
  color: var(--c-green-dark);
  font-weight: 600;
}

.ms-body {
  padding: 0 28rpx;
}

/* 删除通道：只在「当天已有记录」时出。红底块而不是文字链 ——
   它是破坏性操作，必须一眼看出和上面四行的分量不同 */
.ms-del {
  margin: 12rpx 28rpx 24rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: var(--fs-base);
  color: var(--c-red);
  background: var(--c-red-bg);
  border-radius: var(--r-lg);
}

.ms-del:active {
  opacity: 0.6;
}
