.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

/* 名称与月龄同一行：基线对齐（baseline），字号都用 --fs-lg。
   原来月龄是 --fs-display 大字、名字单独占一行，两行两个字号 —— 用户要求
   并到一行且字号一致。右侧阶段 tag 仍留在 .head-row，靠 space-between 靠右。 */
.head-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.head-name {
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--c-text);
}

.head-age {
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--c-text);
}

/* 当前状态：一项都没勾（= 正常）时用中性灰色，真勾了问题项才用琥珀色，避免假警报 */
.head-issue {
  margin-top: 14rpx;
  font-size: var(--fs-md);
  color: var(--c-amber);
}

.head-issue--none {
  color: var(--c-text-3);
}

/* 提醒条 */
.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--c-amber-bg);
}

.notice-text {
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
  flex: 1;
}

.notice-btn {
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
  font-weight: 500;
  padding-left: 20rpx;
}

/* 生病中提醒条 —— 用蓝色和「观察期」的琥珀色区分开 */
.notice-sick {
  background: var(--c-blue-bg);
}

.notice-sick .notice-text,
.notice-sick .notice-btn {
  color: var(--c-blue);
}

/* 喂养提醒 */
.guidance .g-line {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.guidance .g-line:last-child {
  margin-bottom: 0;
}

/* 切换 */
.seg {
  display: flex;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: var(--fs-base);
  color: var(--c-text-2);
  padding: 16rpx 0;
  border-radius: var(--r-sm);
}

.seg-on {
  background: #ffffff;
  color: var(--c-text);
  font-weight: 500;
}

/* 天卡片 */
.day-card {
  padding: 24rpx 28rpx 12rpx;
}

/* 今天：左侧绿边 + 「今天」标签，让用户一眼定位 */
.day-card--today {
  border-left: 6rpx solid var(--c-green);
  padding-left: 22rpx;
}

/* 天卡片头部：左边星期+日期，右边食物覆盖数 */
.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.day-head-l {
  display: flex;
  align-items: center;
  min-width: 0;
}

.day-week {
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--c-text);
  margin-right: 14rpx;
}

.day-date {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
}

.day-today {
  font-size: var(--fs-xs);
  line-height: 1.4;
  color: #ffffff;
  background: var(--c-green);
  border-radius: var(--r-pill);
  padding: 2rpx 16rpx;
  margin-left: 14rpx;
}

/* 新食材 */
.newfood {
  background: var(--c-amber-bg);
  border-radius: var(--r-md);
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
}

.newfood-title {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-amber-ink);
  margin-bottom: 8rpx;
}

.newfood-body {
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
  line-height: 1.6;
}

.newfood-note {
  font-size: var(--fs-xs);
  color: var(--c-amber-ink);
  line-height: 1.6;
  margin-top: 10rpx;
}

/* 餐次 */
.meal {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--c-line);
}

.meal-main {
  display: flex;
  flex-direction: column;
}

.meal-name {
  font-size: var(--fs-lg);
  color: var(--c-text);
  margin-bottom: 6rpx;
}

.meal-meta {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
}

.meal-steps {
  margin-top: 14rpx;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 18rpx 20rpx;
}

.step {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.meal-hint {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--c-line);
}

/* 天卡片头部右侧的食物覆盖数 —— 已并入 .day-head，不再带分隔线 */
.cat-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  font-size: var(--fs-sm);
  text-align: right;
  flex-shrink: 0;
}

.cat-text {
  color: var(--c-text-3);
}

.cat-warn {
  color: var(--c-amber);
}

.shop-tip {
  margin-bottom: 24rpx;
  line-height: 1.7;
}

.empty-title {
  font-size: var(--fs-title);
  color: var(--c-text);
  font-weight: 500;
  margin-bottom: 14rpx;
}
