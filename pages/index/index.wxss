.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

/* 名称与月龄同一行：基线对齐（baseline），字号都用 --fs-lg。
   原来月龄是 --fs-display 大字、名字单独占一行，两行两个字号 —— 用户要求
   并到一行且字号一致。右侧阶段 tag 仍留在 .head-row，靠 space-between 靠右。 */
.head-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.head-name {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--c-text);
}

.head-age {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--c-text);
}

/* 当前状态：一项都没勾（= 正常）时用中性灰色，真勾了问题项才用琥珀色，避免假警报。
   v2.7 · ③ 配套：文字色用 --c-amber-ink 而不是 --c-amber —— #b0761a 当正文
   白底只有 3.85:1（低于 AA 4.5），品牌浅绿面上更低；--c-amber 只留给图标/描边 */
.head-issue {
  margin-top: 14rpx;
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
}

.head-issue--none {
  color: var(--c-text-3);
}

/* 品牌面内的次级说明（stageDesc 的 .muted）：--c-text-3 在浅绿上只有 4.7:1
   （AA 过线但太弱），提到 --c-text-2 = 6.0:1（v2.7 · ③） */
.card--brand .muted {
  color: var(--c-text-2);
}

/* 提醒条 */
.notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--c-amber-bg);
}

.notice-text {
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
  flex: 1;
}

.notice-btn {
  font-size: var(--fs-md);
  color: var(--c-amber-ink);
  font-weight: 500;
  padding-left: 20rpx;
}

/* 生病中提醒条 —— 用蓝色和「观察期」的琥珀色区分开 */
.notice-sick {
  background: var(--c-blue-bg);
}

.notice-sick .notice-text,
.notice-sick .notice-btn {
  color: var(--c-blue);
}

/* 切换 */
.seg {
  display: flex;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: var(--fs-base);
  color: var(--c-text-2);
  padding: 16rpx 0;
  border-radius: var(--r-sm);
}

.seg-on {
  background: #ffffff;
  color: var(--c-text);
  font-weight: 500;
}

/* 天卡片 */
.day-card {
  padding: 24rpx 28rpx 12rpx;
}

/* 今天：左侧绿边 + 「今天」标签 + 日期升 display（A1，v2.2）
   padding-top 加 8rpx 留白，让这一张卡先「停」一下再进内容。
   v2.7 · ①③：加品牌浅绿整面 —— 与顶部信息卡形成「书挡」，主角靠 display
   日期与展开内容拉开层级，不靠换第二种颜色 */
.day-card--today {
  border-left: 6rpx solid var(--c-green);
  padding-left: 22rpx;
  padding-top: 32rpx;
  background: var(--c-green-tint);
}

/* 天卡片头部：左边星期+日期，右边食物覆盖数 / 折叠摘要。
   margin-left:auto 让中段（覆盖/摘要）与箭头一起靠右成组 ——
   否则 space-between 会把摘要甩到正中间 */
.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

/* baseline 而非 center：日期升到 40rpx 后，星期(30)/日期(40)/今天胶囊(22)
   三档字号按基线对齐才顺（与 .head-line 同一处理） */
.day-head-l {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.day-week {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--c-text);
  margin-right: 14rpx;
}

.day-date {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
}

/* A1（v2.2）：今天卡的日期 = 计划页唯一的 display 时刻。
   只有 --today 提档；非今天的日子保持上面的 fs-sm 灰色，全站其余安静。
   （详情页 .fd-name 也用 --fs-display —— 那是另一个页面的主角，不算冲突） */
.day-card--today .day-date {
  font-size: var(--fs-display);
  font-weight: 600;
  color: var(--c-text);
}

.day-today {
  font-size: var(--fs-xs);
  line-height: 1.4;
  color: #ffffff;
  background: var(--c-green);
  border-radius: var(--r-pill);
  padding: 2rpx 16rpx;
  margin-left: 14rpx;
}

/* 新食材 */
/* —— 折叠摘要与展开箭头（v2.7 · ①⑥）—— */

/* 非今天的头部本身是按钮：按下给反馈（同 mine 页 .row-tap 的力度） */
.day-head--tap:active {
  opacity: 0.6;
}

/* 折叠态右侧：餐数 · 类数（覆盖信息折叠后仍可见）+ 待打卡提示 */
.day-peek {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-left: auto;
  flex-shrink: 0;
  font-size: var(--fs-sm);
}

.day-peek-sum {
  color: var(--c-text-2);
}

.day-peek-todo {
  /* 白底 10:1；--c-amber 当正文 AA 不过关，一律 amber-ink */
  color: var(--c-amber-ink);
}

/* 展开箭头：节点常驻（今天除外），旋转过渡才存在；文案恒为 ▸ */
.day-arrow {
  display: inline-block;
  margin-left: 16rpx;
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  transition: transform 0.18s ease;
  flex-shrink: 0;
}

/* v2.25 · 方案A：.newfood* 观察卡样式已随「首页不再渲染新食材尝试」移除 ——
   观察卡与观察态都在档案页（pages/profile/profile.wxss）。 */

/* 时段锚点（v2.9 · 方案A）：时段头 = 时刻 + 菜名 + 质地/类别小标签 + 正/加餐 chip
   + 右侧奶标注，一行基线对齐（样式修订：时段名不渲染，整行可点展开） */
.slot-head {
  display: flex;
  align-items: baseline;
  column-gap: 16rpx;
  padding: 24rpx 0 4rpx;
}

.slot-time {
  font-size: var(--fs-base);
  font-weight: 600; /* 与站内字重三档一致，不引入新档 */
  color: var(--c-text);
}

.slot-kind {
  font-size: var(--fs-xs);
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.slot-kind.snack {
  background: var(--c-blue-bg);
  color: var(--c-blue);
}

.slot-withmilk {
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  white-space: nowrap;
  margin-left: auto;  /* 「辅食 + 奶」右对齐，不挤时刻与 chip */
  margin-right: 24rpx; /* 与上下奶行「时段参考」同列 —— 奶盒内边距 24rpx */
}

/* 奶参考行：只标时段，不排菜、不打卡（方案A 的视觉核心） */
.milk-row {
  display: flex;
  align-items: center;
  column-gap: 16rpx;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.milk-name {
  font-size: var(--fs-sm);
  color: var(--c-text-2);
}

.milk-note {
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  margin-left: auto;
}

/* 方案C · 主餐卡（v2.10 合并重铸）：时刻头 + 并入的观察条 + 步骤/打卡收成一张
   白卡 —— 主餐是这天的主角。横向内边距 24rpx 与奶盒内边距一致（内容列对齐）；
   卡内 .slot-withmilk 归零 —— 基础规则那 24rpx 由卡内边距接管，右缘仍与
   「时段参考」同列。白底 vs 白底靠 1rpx 描边分界（§6l：阴影只许 .card 一处，
   这里不引新阴影） */
.meal-card {
  background: var(--c-card);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-md);
  padding: 0 24rpx 8rpx;
  margin-top: 16rpx;
}
/* 今天：3rpx 绿边条与 day-card--today 的 6rpx 呼应 —— 今天的主餐再压一头 */
.day-card--today .meal-card {
  border-left: 3rpx solid var(--c-green);
}
.meal-card .slot-withmilk {
  margin-right: 0; /* 卡内 24rpx 已接管（基础规则保持 24rpx —— §6q 5b 钉） */
}
/* 时段头后面的餐次行：顶部分隔线由时段头的留白接管，别叠双线 */
.slot-head + .meal {
  border-top: none;
  padding-top: 8rpx;
}

/* 餐次 */
.meal {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--c-line);
}

/* 餐次行（v2.7 · ①）：菜名 + 小标签同行、基线对齐。
   原来菜名下方那行「质地 · 克数」灰字被拆掉 —— 质地与类别变成小标签随菜名，
   克数下沉到展开的步骤里逐食材写明（data/recipes.js 的 {分类} 占位符，plan.js 填数） */
.meal-main {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  column-gap: 10rpx;
  row-gap: 8rpx;
}

.meal-name {
  font-size: var(--fs-lg);
  font-weight: 600; /* 菜单主角（v2.7 · ② 标题档） */
  color: var(--c-text);
}

.meal-tag {
  margin: 0; /* 全局 .tag 的 margin-right/bottom 在 flex + gap 下会叠成双倍 */
}

.meal-steps {
  margin-top: 14rpx;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 18rpx 20rpx;
}

.step {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.meal-hint {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--c-line);
}

/* 每餐打卡（v2.1）：三态按钮（v2.25 起「有反应」移到档案页）。颜色全走 token */
.meal-log {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ml-btn {
  /* B2（v2.2）：打卡是 v2.1 高频主操作，命中区 ≥44pt —— 高度用 min-height
     直接表达（96rpx：iOS=48pt，Android 360dp 屏≈46dp），不靠 padding 反推
     （那依赖 line-height 1.6 永不被改）。flex 居中是配套项，否则 min-height
     会把文字顶在上边；border-box 保证 min-height 含 1rpx 边框 = 准确 96 */
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: var(--fs-sm);
  color: var(--c-text-2);
  background: var(--c-muted);
  border: 1rpx solid var(--c-line);
}

/* .ml-btn-react（有反应）已随入口移到档案页 —— 死样式删掉 */

.ml-state {
  /* 与 .ml-btn 同高（96rpx）→ 打卡前后整行高度不跳。
     <text> 是 flex 行子项（已块化），垂直 padding 生效；不加 min-height：
     若基础是 content-box，min-height 会与 padding 叠加爆高。
     算术：line-height 40 + padding 28×2 = 96，两种 box-sizing 下都成立 */
  padding: 28rpx 26rpx;
  line-height: 40rpx;
  font-size: var(--fs-sm);
  color: var(--c-green-dark);
  background: var(--c-green-bg);
  border-radius: 999rpx;
}

.ml-s-refused {
  color: var(--c-text-2);
  background: var(--c-muted);
}

.ml-s-reaction {
  color: var(--c-red);
  background: var(--c-red-bg);
}

.ml-undo {
  /* 撤销也是真点击目标：与按钮同高，命中区 72×54 → 100×96（算术同 .ml-state） */
  padding: 28rpx 26rpx;
  line-height: 40rpx;
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  text-decoration: underline;
}

/* 天卡片头部右侧的食物覆盖数 —— 已并入 .day-head，不再带分隔线。
   margin-left:auto 与 .day-peek 同理：和箭头成组靠右，不被 space-between 甩到中间 */
.cat-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  font-size: var(--fs-sm);
  text-align: right;
  flex-shrink: 0;
  margin-left: auto;
}

.cat-text {
  color: var(--c-text-3);
}

.cat-warn {
  /* 同 .head-issue：琥珀文字走 amber-ink（--c-amber 当正文 AA 不过关） */
  color: var(--c-amber-ink);
}

.shop-tip {
  margin-bottom: 24rpx;
  line-height: 1.7;
}

/* 采购清单行：标签里嵌了 emoji 徽标，flex 才能和右侧次数同行 */
.shop-label {
  display: flex;
  align-items: center;
}

/* —— tooYoung 分支的「开始之前」说明（全部 <6 月龄可见）—— */
.empty-guide {
  /* 下面就要接 3 张说明卡，intro 不需要空状态那种大留白 */
  padding: 60rpx 40rpx 24rpx;
}

/* 卡头：emoji 徽标 + 标题同行。徽标是块级 view，
   不 flex 会把标题挤到下一行（同 §6g 对 .shop-label 的约束） */
.guide-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.guide-head > .card-title {
  margin-bottom: 0;
}

.guide-line {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.guide-line:last-child {
  margin-bottom: 0;
}

.empty-title {
  font-size: var(--fs-title);
  color: var(--c-text);
  font-weight: 600;
  margin-bottom: 14rpx;
}

/* —— 6 月龄说明卡（添加要点 / 怎么做辅食）：默认收起，点头部展开 —— */
.guide-head--tap {
  /* 头部本身就是按钮，收起时是卡片最后一行 —— 间距交给 .guide-body 负责 */
  margin-bottom: 0;
}

.guide-arrow {
  /* 推到最右（flex 行里 margin-left:auto），提示可点开。
     v2.7 · ⑥：文案恒为 ▸，展开态靠 .link-arrow-open 旋转 90° ——
     在 ▸/▾ 之间换字是节点重建，没有过渡可言；旋转必须挂在常驻节点上 */
  margin-left: auto;
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  padding-left: 16rpx;
  display: inline-block;
  transition: transform 0.18s ease;
}

.guide-body {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--c-line);
  padding-top: 16rpx;
}

.guide-pt-title {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-text);
  margin-bottom: 6rpx;
}

.guide-pt-text {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 16rpx;
  /* 文案里的 \n 要真换行（第一口辅食、观察过敏是分行写法） */
  white-space: pre-line;
}

.guide-point:last-child .guide-pt-text {
  margin-bottom: 0;
}
