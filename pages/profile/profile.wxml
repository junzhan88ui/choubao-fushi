<view class="page-wrap page-wrap--safe">

  <!-- 宝宝信息：名称 + 生日（两张控件各写各的字段，由 setBaby 合并） -->
  <view class="card">
    <!-- 标题行：左标题、右补充信息，基线对齐 -->
    <view class="card-head">
      <view class="card-title">宝宝信息</view>
      <view class="age-now" wx:if="{{ageText}}">现在 {{ageText}}</view>
    </view>
    <view class="card-sub">名称和出生日期都是必填，两项都填好才能生成计划。</view>
    <view class="row">
      <text class="row-label">宝宝名称<text class="req">*</text></text>
      <input class="row-input" value="{{name}}" placeholder="必填，如：臭宝"
             placeholder-class="row-input-ph" maxlength="{{nameMax}}"
             bindinput="onNameInput" />
    </view>
    <picker mode="date" value="{{birthday}}" start="{{minDate}}" end="{{today}}" bindchange="onDateChange">
      <view class="row">
        <text class="row-label">出生日期<text class="req">*</text></text>
        <text class="row-value">{{birthday || '点击选择'}}</text>
      </view>
    </picker>
  </view>

  <!-- 宝宝状态 -->
  <view class="card">
    <view class="card-title">宝宝状态怎么样</view>
    <view class="card-sub">可多选，会影响搭配方向。</view>
    <view class="chips">
      <view class="chip {{item.on ? 'chip-on' : ''}}"
            wx:for="{{statuses}}" wx:key="key" wx:for-item="item"
            data-key="{{item.key}}" bindtap="onStatusChange">{{item.label}}</view>
    </view>
  </view>

  <!-- 观察期 -->
  <view class="card" wx:if="{{observing.length > 0}}">
    <view class="card-title">正在观察的食材</view>
    <view class="card-sub">引入后观察 3 天，确认没问题再组合进菜单</view>
    <view class="obs-item" wx:for="{{observing}}" wx:key="foodId" wx:for-item="o">
      <view class="obs-head">
        <text class="obs-name">{{o.name}}</text>
        <text class="muted">{{o.date}} 开始</text>
      </view>
      <view class="obs-actions">
        <view class="mini-btn mini-ok" data-id="{{o.foodId}}" data-ok="1" bindtap="confirmObservation">没问题</view>
        <view class="mini-btn mini-bad" data-id="{{o.foodId}}" data-ok="0" bindtap="confirmObservation">有反应</view>
      </view>
    </view>
  </view>

  <!-- 已吃过的食材 -->
  <view class="card">
    <view class="card-title">已经吃过、没问题的食材</view>
    <view class="card-sub">勾选 = 已经吃过、确认没问题，会直接排进菜单。带「敏」的是常见致敏食材，不用提前勾选 —— 它们会通过「新食材尝试」逐个引入。</view>

    <view class="search">
      <input class="search-input" placeholder="搜食材，如 南瓜 / 蛋黄"
             value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">清空</view>
    </view>

    <view class="group" wx:for="{{groups}}" wx:key="category" wx:for-item="g">
      <view class="group-name">{{g.category}}</view>
      <view class="chips">
        <view class="chip {{f.checked ? 'chip-on' : ''}} {{f.status === 'bad' ? 'chip-bad' : ''}}"
              style="{{!f.checked && f.status !== 'bad' ? 'background:' + f.iconBg : ''}}"
              wx:for="{{g.foods}}" wx:key="id" wx:for-item="f"
              data-id="{{f.id}}" bindtap="toggleFood">
          <text class="chip-ic">{{f.icon}}</text>
          <text>{{f.name}}</text>
          <text class="chip-flag" wx:if="{{f.allergen}}">敏</text>
          <text class="chip-flag chip-flag-bad" wx:if="{{f.status === 'bad'}}">有反应</text>
        </view>
      </view>
    </view>

    <view class="muted empty-hit" wx:if="{{groups.length === 0}}">没找到这个食材，换个词试试</view>

    <view class="count-line">已勾选 {{totalChecked}} 种</view>
  </view>

  <button class="btn btn-primary" bindtap="goBack">完成</button>

  <view class="disclaimer">
    这里的月龄与食材信息参考公开喂养指南整理，仅供参考。每个宝宝的添加节奏不同，具体请遵医嘱。
  </view>
</view>
