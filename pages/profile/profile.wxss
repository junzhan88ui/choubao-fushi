/* 标题行：左标题、右补充信息（当前月龄）
   用 baseline 而不是 center —— 32rpx 标题和 24rpx 小字并排时，
   baseline 才落在同一条线上；center 会让小字相对标题往下沉。
   同 food-detail 的 .fd-head，别改回 center。 */
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  /* 标题过长或月龄文字过长时换行兜底，不至于把小字挤出卡片 */
  flex-wrap: wrap;
  /* 原来是 .card-title 自带的 margin-bottom，标题进容器后要改由容器承担，
     否则标题自身的 margin 会在 flex 里把容器撑高 */
  margin-bottom: 16rpx;
}

/* 同行时标题不再自带下边距，间距统一收到上面的容器 */
.card-head > .card-title {
  margin-bottom: 0;
}

.age-now {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
}

/* 名称输入框：靠右，和 .row-value 落在同一视觉位置。
   占位符用 muted，和「点击选择」那个右值一致 */
.row-input {
  flex: 1;
  text-align: right;
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-text);
}

.row-input-ph {
  color: var(--c-text-3);
}

/* 必填星号（名称 / 出生日期） */
.req {
  color: var(--c-red);
  margin-left: 6rpx;
}

/* 选项 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  display: flex;
  align-items: center;
  font-size: var(--fs-md);
  color: var(--c-text-2);
  background: var(--c-muted);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-pill);
  padding: 12rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip-on {
  background: var(--c-green-bg);
  border-color: #9ec96a;
  color: var(--c-green-dark);
  font-weight: 500;
}

/* 「有反应」= 已标记不良反应，永久排除。
   必须和普通未勾选区分开：两者都是未选中态，但点击语义完全不同
   （普通 = 加入安全列表，bad = 已被保护起来，点了只弹提示不会解除）。 */
.chip-bad {
  background: var(--c-red-bg);
  border-color: #e8b8b8;
  color: var(--c-red);
}

.chip-flag-bad {
  color: var(--c-red);
  border-color: #e8b8b8;
}

/* 「敏」= 常见致敏食材，中性描边，不做红色警示 */
/* chip 内 emoji（v2.0）：托底由 chip 自己的分类色承担，emoji 不再套一层徽标 */
.chip-ic {
  margin-right: 10rpx;
}

.chip-flag {
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-sm);
  padding: 0 8rpx;
  margin-left: 8rpx;
}

/* 观察期 */
.obs-item {
  border-top: 1rpx solid var(--c-line);
  padding: 20rpx 0;
}

.obs-item:first-of-type {
  border-top: none;
}

.obs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.obs-name {
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--c-text);
}

.obs-actions {
  display: flex;
}

.mini-btn {
  font-size: var(--fs-md);
  padding: 10rpx 28rpx;
  border-radius: var(--r-pill);
  margin-right: 16rpx;
}

.mini-ok {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.mini-bad {
  background: var(--c-red-bg);
  color: var(--c-red);
}

/* 搜索框沿用 app.wxss 的全局 .search（默认即卡片内嵌样式） */

/* 分组 */
.group {
  margin-top: 26rpx;
}

.group-name {
  font-size: var(--fs-md);
  color: var(--c-text-3);
  margin-bottom: 14rpx;
}

.empty-hit {
  padding: 40rpx 0;
  text-align: center;
}

.count-line {
  margin-top: 24rpx;
  font-size: var(--fs-md);
  color: var(--c-text-3);
  text-align: right;
}
