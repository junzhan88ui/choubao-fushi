.age-line {
  margin-top: 16rpx;
}

/* 选项 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  display: flex;
  align-items: center;
  font-size: var(--fs-md);
  color: var(--c-text-2);
  background: var(--c-muted);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-pill);
  padding: 12rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip-on {
  background: var(--c-green-bg);
  border-color: #9ec96a;
  color: var(--c-green-dark);
  font-weight: 500;
}

/* 「有反应」= 已标记不良反应，永久排除。
   必须和普通未勾选区分开：两者都是未选中态，但点击语义完全不同
   （普通 = 加入安全列表，bad = 已被保护起来，点了只弹提示不会解除）。 */
.chip-bad {
  background: var(--c-red-bg);
  border-color: #e8b8b8;
  color: var(--c-red);
}

.chip-flag-bad {
  color: var(--c-red);
  border-color: #e8b8b8;
}

/* 「敏」= 常见致敏食材，中性描边，不做红色警示 */
.chip-flag {
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-sm);
  padding: 0 8rpx;
  margin-left: 8rpx;
}

/* 观察期 */
.obs-item {
  border-top: 1rpx solid var(--c-line);
  padding: 20rpx 0;
}

.obs-item:first-of-type {
  border-top: none;
}

.obs-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.obs-name {
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--c-text);
}

.obs-actions {
  display: flex;
}

.mini-btn {
  font-size: var(--fs-md);
  padding: 10rpx 28rpx;
  border-radius: var(--r-pill);
  margin-right: 16rpx;
}

.mini-ok {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.mini-bad {
  background: var(--c-red-bg);
  color: var(--c-red);
}

/* 搜索框沿用 app.wxss 的全局 .search（默认即卡片内嵌样式） */

/* 分组 */
.group {
  margin-top: 26rpx;
}

.group-name {
  font-size: var(--fs-md);
  color: var(--c-text-3);
  margin-bottom: 14rpx;
}

.empty-hit {
  padding: 40rpx 0;
  text-align: center;
}

.count-line {
  margin-top: 24rpx;
  font-size: var(--fs-md);
  color: var(--c-text-3);
  text-align: right;
}
