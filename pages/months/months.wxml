<!-- 各月龄滑动指南（v2.30；v2.31 改 8 页）：6–12 月逐月 + 最后一页「1 岁以上」
     （13–24 统一，guides.onePlus），每页 = 怎么喂 + 注意事项 + 一周食谱（参考）
     只常渲染「当前 ±1」三页（months.js buildSlides 的 active 窗口），远页留骨架 -->
<view class="mth-page">

  <view class="mth-hint muted">左右滑动切换月龄 · 6–12 月逐月、13 月龄起为「1 岁以上」统一页；每页：怎么喂 / 注意事项 / 一周食谱（参考）</view>

  <swiper class="mth-swiper" current="{{current}}" bindchange="onMonthChange"
          indicator-dots="{{true}}" indicator-color="#dcdcd6" indicator-active-color="#3b6d11">
    <swiper-item wx:for="{{slides}}" wx:key="key" wx:for-item="slide">

      <scroll-view scroll-y class="mth-scroll" wx:if="{{slide.active}}">

        <!-- 月头：月龄（或「1 岁以上」）+ 当前阶段（性状/餐次一句话） -->
        <view class="card card--brand mth-head">
          <view class="mth-month">{{slide.title}}</view>
          <view class="muted" wx:if="{{slide.stageDesc}}">{{slide.stageLabel}} · {{slide.stageDesc}}</view>
        </view>

        <!-- 怎么喂 / 注意事项（6 月两张原题卡、7–12 分月卡、1 岁以上统一卡 ——
             13–24 占位分支已随 v2.31 内容落地整套删除，§6t 反向钉） -->
        <view class="card card-guide" wx:for="{{slide.cards}}" wx:key="key" wx:for-item="g">
          <view class="guide-head">
            <view class="food-ic" style="background:{{g.iconBg}}">{{g.icon}}</view>
            <view class="card-title">{{g.title}}</view>
          </view>
          <view class="guide-point" wx:for="{{g.points}}" wx:for-item="pt" wx:key="title">
            <view class="guide-pt-title">{{pt.title}}</view>
            <view class="guide-pt-text">{{pt.text}}</view>
          </view>
          <view class="guide-line" wx:for="{{g.lines}}" wx:for-item="line" wx:key="*this">{{line}}</view>
        </view>

        <!-- 一周食谱（参考）：通用样例，非宝宝个人计划；口径随页（menuTip） -->
        <view class="card">
          <view class="card-title">一周食谱（参考）</view>
          <view class="muted mth-tip">{{slide.menuTip}}</view>
          <view class="mth-day" wx:for="{{slide.menu}}" wx:key="id" wx:for-item="day">
            <view class="mth-day-h">
              <text class="mth-day-w {{day.isWeekend ? 'mth-day-we' : ''}}">{{day.weekday}}</text>
              <text class="mth-day-d">{{day.dateLabel}}</text>
            </view>
            <view class="mth-item {{it.kind === 'snack' ? 'mth-item--snack' : ''}}"
                  wx:for="{{day.items}}" wx:key="id" wx:for-item="it">
              <text class="mth-time">{{it.time}}</text>
              <text class="mth-name">{{it.name}}</text>
              <text class="tag tag-grey">{{it.texture}}</text>
            </view>
          </view>
          <view class="muted" wx:if="{{!slide.menu.length}}">这个月龄暂时排不出样例食谱</view>
        </view>

        <view class="mth-gap"></view>
      </scroll-view>

      <!-- 远页骨架（当前 ±1 之外）：节点省着用，滑到再挂内容 -->
      <view class="mth-skel" wx:else>
        <text class="mth-skel-month">{{slide.title}}</text>
      </view>

    </swiper-item>
  </swiper>

  <view class="disclaimer">
    本页内容参考公开喂养指南整理，仅供参考，不能替代医生或注册营养师的专业意见。宝宝出现过敏、疾病或生长发育异常，请及时就医。
  </view>
</view>
