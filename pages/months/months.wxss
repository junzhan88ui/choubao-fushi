/* 各月龄滑动指南（v2.30）：整页三段纵排 —— 提示行 / swiper（占满）/ 免责声明 */
.mth-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--c-bg, #faf9f6);
}

.mth-hint {
  padding: 16rpx 32rpx 8rpx;
  font-size: var(--fs-sm);
}

.mth-swiper {
  flex: 1;
  min-height: 0;
}

.mth-scroll {
  height: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 月头（品牌面，与首页 head 卡同色系） */
.mth-head {
  margin-top: 8rpx;
}

.mth-month {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 6rpx;
}

/* 知识卡头：徽标 + 标题同行（同 index .guide-head 约束：徽标块级不 flex 会挤行） */
.guide-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.guide-head > .card-title {
  margin-bottom: 0;
}

.guide-pt-title {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-text);
  margin-bottom: 6rpx;
}

.guide-pt-text {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 16rpx;
  /* 文案里的 \n 要真换行（第一口辅食、观察过敏是分行写法） */
  white-space: pre-line;
}

.guide-point:last-child .guide-pt-text {
  margin-bottom: 0;
}

.guide-line {
  font-size: var(--fs-md);
  color: var(--c-text-2);
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.guide-line:last-child {
  margin-bottom: 0;
}

/* 13–24 月龄占位（内容整理中） */
.mth-ph {
  font-size: var(--fs-base);
  font-weight: 500;
  color: var(--c-text-3);
  margin-bottom: 8rpx;
}

/* 一周食谱（参考） */
.mth-tip {
  font-size: var(--fs-sm);
  margin: -6rpx 0 16rpx;
}

.mth-day {
  padding: 14rpx 0;
  border-top: 1rpx solid var(--c-line);
}

.mth-day-h {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.mth-day-w {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--c-text);
}

.mth-day-we {
  color: var(--c-green-dark);
}

.mth-day-d {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
}

.mth-item {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 6rpx 0;
}

.mth-time {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  /* 6 列月龄正餐时刻一样宽（07:00/10:00…）—— 定宽让菜名左缘对齐 */
  width: 76rpx;
  flex-shrink: 0;
}

.mth-name {
  font-size: var(--fs-md);
  color: var(--c-text);
  flex: 1;
  min-width: 0;
}

.mth-item--snack .mth-name {
  color: var(--c-text-2);
}

/* 远页骨架：只要能看出跳到几月 */
.mth-skel {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mth-skel-month {
  font-size: var(--fs-lg);
  font-weight: 600;
  color: var(--c-text-3);
}

/* 底部免责声明前的留白 */
.mth-gap {
  height: 24rpx;
}
