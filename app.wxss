/* 全局样式 —— 臭宝吃什么 */
page {
  --c-bg: #faf9f6;
  --c-card: #ffffff;
  --c-text: #2c2c2a;
  --c-text-2: #5f5e5a;
  --c-text-3: #8a8a86;
  --c-line: #ecebe6;
  --c-green: #5f8b28;
  --c-green-dark: #3b6d11;
  --c-green-bg: #eaf3de;
  --c-amber: #b0761a;
  --c-amber-bg: #faeeda;
  --c-red: #a32d2d;
  --c-red-bg: #fcebeb;
  --c-blue: #185fa5;
  --c-blue-bg: #e6f1fb;

  background: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page-wrap {
  padding: 24rpx 24rpx 60rpx;
}

/* 卡片 */
.card {
  background: var(--c-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-tight {
  padding: 20rpx 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--c-text);
  margin-bottom: 16rpx;
}

.card-sub {
  font-size: 24rpx;
  color: var(--c-text-3);
  margin-bottom: 20rpx;
}

/* 文字 */
.muted {
  color: var(--c-text-3);
  font-size: 24rpx;
}

.strong {
  font-weight: 500;
}

.center {
  text-align: center;
}

/* 行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: var(--c-text-2);
  font-size: 28rpx;
}

.row-value {
  color: var(--c-text);
  font-size: 28rpx;
  font-weight: 500;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.tag-green {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.tag-amber {
  background: var(--c-amber-bg);
  color: #633806;
}

.tag-red {
  background: var(--c-red-bg);
  color: var(--c-red);
}

.tag-blue {
  background: var(--c-blue-bg);
  color: var(--c-blue);
}

.tag-grey {
  background: #f1efe8;
  color: var(--c-text-2);
}

/* 按钮 */
.btn {
  display: block;
  width: 100%;
  padding: 26rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  background: #f1efe8;
  color: var(--c-text);
  border: none;
  line-height: 1.4;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--c-green);
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: var(--c-text-2);
  border: 1rpx solid var(--c-line);
}

/* 空状态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--c-text-3);
  font-size: 26rpx;
}

/* 免责声明 */
.disclaimer {
  font-size: 22rpx;
  color: var(--c-text-3);
  line-height: 1.7;
  padding: 24rpx 8rpx 0;
}

/* 分割 */
.divider {
  height: 1rpx;
  background: var(--c-line);
  margin: 20rpx 0;
}
