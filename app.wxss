/* 全局样式 —— 臭宝吃什么 */
/* 设计 token：字号 7 级（22/24/26/28/30/32/40）· 圆角 5 级（8/12/16/20/999）· 中性色 4 档
   语义色含品牌浅绿 --c-green-tint（v2.7 · ③：大面积色块专用，与标签底 --c-green-bg 分工） */
page {
  /* —— 中性色 —— */
  --c-bg: #faf9f6;
  --c-card: #ffffff;
  --c-muted: #f4f3ef; /* 次级底：分段控件 / 默认按钮 / 内嵌块 / 灰标签 */
  --c-line: #ecebe6;

  /* —— 文字（白底对比度：正文 13.4:1 · 次级 6.5:1 · 辅助 5.1:1，均过 WCAG AA）—— */
  --c-text: #2c2c2a;
  --c-text-2: #5f5e5a;
  --c-text-3: #6f6e6a;

  /* —— 语义色 —— */
  --c-green: #5f8b28;
  --c-green-dark: #3b6d11;
  --c-green-bg: #eaf3de;
  --c-green-tint: #f2f8ea; /* 品牌浅绿：顶部信息卡 / 今天卡的整面底色，比标签底浅一档 */
  --c-amber: #b0761a;
  --c-amber-ink: #633806; /* 琥珀底上的文字，8.7:1 */
  --c-amber-bg: #faeeda;
  --c-red: #a32d2d;
  --c-red-bg: #fcebeb;
  --c-blue: #185fa5;
  --c-blue-bg: #e6f1fb;

  /* —— 字号 —— */
  --fs-xs: 22rpx;
  --fs-sm: 24rpx;
  --fs-md: 26rpx;
  --fs-base: 28rpx;
  --fs-lg: 30rpx;
  --fs-title: 32rpx;
  --fs-display: 40rpx;

  /* —— 圆角 —— */
  --r-sm: 8rpx;
  --r-md: 12rpx;
  --r-lg: 16rpx;
  --r-card: 20rpx;
  --r-pill: 999rpx;

  background: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: var(--fs-base);
  line-height: 1.6;
}

.page-wrap {
  padding: 24rpx 24rpx 60rpx;
}

/* 非 tabBar 页面（档案 / 食材详情）：底部让出全面屏安全区 */
.page-wrap--safe {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* 卡片 */
.card {
  background: var(--c-card);
  border-radius: var(--r-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
  /* B1（v2.2）：白卡 vs 暖白底只差约 1.5%，全站又靠 1rpx 描边分层，
     低亮度下会糊成一片 —— 加一层极浅阴影把卡「托」起来。
     颜色取自 --c-text（#2c2c2a），透明度 0.05 只做边界提示，不做立体感。 */
  box-shadow: 0 2rpx 10rpx rgba(44, 44, 42, 0.05);
}

.card-tight {
  padding: 20rpx 24rpx;
}

/* 品牌面（v2.7 · ③）：全站唯一大面积色块 —— 顶部信息卡与今天卡共用浅绿，
   绿从「状态色」升格为「我们的颜色」。只换背景：阴影仍由 .card 一处提供（§6l）。 */
.card--brand {
  background: var(--c-green-tint);
}

.card-title {
  /* 字重三档（v2.7 · ②）：标题 600 / 强调 500 / 正文 400 —— 层级靠字，不靠灰色 */
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 16rpx;
}

.card-sub {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  margin-bottom: 20rpx;
  line-height: 1.7;
}

/* 文字 */
.muted {
  color: var(--c-text-3);
  font-size: var(--fs-sm);
}

/* .strong 已删除 —— 全仓零引用的死样式（§6l 反向钉） */

.center {
  text-align: center;
}

/* 行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: var(--c-text-2);
  font-size: var(--fs-base);
}

.row-value {
  color: var(--c-text);
  font-size: var(--fs-base);
  font-weight: 500;
}

/* 标签 */
/* 标签（评审提案②）：圆角 8rpx 直角 → 胶囊。
   站内多数派本就是 999rpx（打卡/正餐·加餐/今天/mini 按钮全是胶囊），
   语义相同的小标同屏两种几何是形状系统破绽 —— 向多数派收敛。
   水平 padding 14→16rpx 配平胶囊观感；语义色/字号/边距一律不动 */
.tag {
  display: inline-block;
  font-size: var(--fs-xs);
  line-height: 1.4;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.tag-green {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

/* .tag-amber / .tag-red / .tag-blue 已删除 —— 全仓零引用的死样式（§6l 反向钉）。
   在用的 .tag-green / .tag-grey / .tag-outline 一个没动。 */

.tag-grey {
  background: var(--c-muted);
  color: var(--c-text-2);
}

/* 「常见致敏」标记：中性描边，不做成红色警示（过敏原不等于危险，见指南准则二） */
.tag-outline {
  background: transparent;
  color: var(--c-text-3);
  border: 1rpx solid var(--c-line);
}

/* 食材图标徽标（v2.0）：emoji 托在分类底色上。
   底色由 data/food-icons.js 按分类给出，这里只管徽标形状，四处展示
   （查一查列表 / 首页新食材卡 / 采购清单）共用这一份；详情页头部
   用 .fd-ic 放大。emoji 只是视觉锚点 —— 食材名永远保留，不能只留图标。 */
.food-ic {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--r-md);
  font-size: 30rpx;
  line-height: 1;
  flex-shrink: 0;
  margin-right: 14rpx;
  /* 在白卡片上给浅底色一道边界；琥珀色新食材卡里也靠它不糊掉 */
  border: 1rpx solid var(--c-line);
}

/* 状态徽标（v2.30 收进全局）：「查一查」列表行与「档案页」chips 共用同一套
   词与同一份样式 —— st-new=未引入 / st-safe=已吃过 / st-bad=有反应。
   「st-observing」已随 3 天观察期规则删除（§6u 反向钉），别加回来。 */
.food-status {
  font-size: var(--fs-xs);
  padding: 4rpx 14rpx;
  border-radius: var(--r-sm);
}

.st-safe {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.st-bad {
  background: var(--c-red-bg);
  color: var(--c-red);
}

.st-new {
  background: var(--c-muted);
  color: var(--c-text-3);
}

/* 按钮 */
.btn {
  display: block;
  width: 100%;
  padding: 26rpx 0;
  border-radius: var(--r-lg);
  font-size: var(--fs-lg);
  font-weight: 500;
  text-align: center;
  background: var(--c-muted);
  color: var(--c-text);
  border: none;
  line-height: 1.4;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--c-green);
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: var(--c-text-2);
  border: 1rpx solid var(--c-line);
}

/* 搜索框（全局统一：置于页面底色上时加 .search--card） */
.search {
  display: flex;
  align-items: center;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.search--card {
  background: #ffffff;
}

.search-input {
  flex: 1;
  font-size: var(--fs-base);
  padding: 22rpx 0;
  color: var(--c-text);
}

.search-clear {
  font-size: var(--fs-md);
  color: var(--c-text-3);
  padding-left: 16rpx;
}

/* 空状态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--c-text-3);
  font-size: var(--fs-md);
}

/* 免责声明 */
.disclaimer {
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  line-height: 1.7;
  padding: 24rpx 8rpx 0;
}

/* .divider 已删除 —— 全仓零引用的死样式（§6l 反向钉） */

/* ── 展开动效（v2.7 · ⑥）──
   wx:if 创建节点时播放一次：0.18s 淡入 + 8rpx 上移。收起是节点销毁，
   小程序里做不了收起过渡 —— 接受「展开柔和、收起干脆」，不引入常驻节点。
   只挂「用户点开」的节点（步骤 / 指南 / 记录展开 / 非今天的天）——
   今天卡恒展开，刷新重建不算入场动画。 */
.fx-in {
  animation: fxIn 0.18s ease-out;
}

@keyframes fxIn {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 箭头旋转（v2.7 · ⑥）：收起 ▸ → 展开转 90° 指向下，0.18s 过渡。
   旋转必须挂在「常驻节点」上 —— 文本在 ▸/▾ 之间换字是节点重建，没有过渡。
   transition 放在各 base 类（.link-arrow / .guide-arrow / .day-arrow）上，
   本修饰类全站共享（原定义在 mine.wxss，页面 wxss 不跨页生效，故上移到这里）。 */
.link-arrow-open {
  transform: rotate(90deg);
}
