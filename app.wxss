/* 全局样式 —— 臭宝吃什么 */
/* 设计 token：字号 7 级（22/24/26/28/30/32/40）· 圆角 5 级（8/12/16/20/999）· 中性色 4 档 */
page {
  /* —— 中性色 —— */
  --c-bg: #faf9f6;
  --c-card: #ffffff;
  --c-muted: #f4f3ef; /* 次级底：分段控件 / 默认按钮 / 内嵌块 / 灰标签 */
  --c-line: #ecebe6;

  /* —— 文字（白底对比度：正文 13.4:1 · 次级 6.5:1 · 辅助 5.1:1，均过 WCAG AA）—— */
  --c-text: #2c2c2a;
  --c-text-2: #5f5e5a;
  --c-text-3: #6f6e6a;

  /* —— 语义色 —— */
  --c-green: #5f8b28;
  --c-green-dark: #3b6d11;
  --c-green-bg: #eaf3de;
  --c-amber: #b0761a;
  --c-amber-ink: #633806; /* 琥珀底上的文字，8.7:1 */
  --c-amber-bg: #faeeda;
  --c-red: #a32d2d;
  --c-red-bg: #fcebeb;
  --c-blue: #185fa5;
  --c-blue-bg: #e6f1fb;

  /* —— 字号 —— */
  --fs-xs: 22rpx;
  --fs-sm: 24rpx;
  --fs-md: 26rpx;
  --fs-base: 28rpx;
  --fs-lg: 30rpx;
  --fs-title: 32rpx;
  --fs-display: 40rpx;

  /* —— 圆角 —— */
  --r-sm: 8rpx;
  --r-md: 12rpx;
  --r-lg: 16rpx;
  --r-card: 20rpx;
  --r-pill: 999rpx;

  background: var(--c-bg);
  color: var(--c-text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: var(--fs-base);
  line-height: 1.6;
}

.page-wrap {
  padding: 24rpx 24rpx 60rpx;
}

/* 非 tabBar 页面（档案 / 食材详情）：底部让出全面屏安全区 */
.page-wrap--safe {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* 卡片 */
.card {
  background: var(--c-card);
  border-radius: var(--r-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-tight {
  padding: 20rpx 24rpx;
}

.card-title {
  font-size: var(--fs-title);
  font-weight: 500;
  color: var(--c-text);
  margin-bottom: 16rpx;
}

.card-sub {
  font-size: var(--fs-sm);
  color: var(--c-text-3);
  margin-bottom: 20rpx;
  line-height: 1.7;
}

/* 文字 */
.muted {
  color: var(--c-text-3);
  font-size: var(--fs-sm);
}

.strong {
  font-weight: 500;
}

.center {
  text-align: center;
}

/* 行 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--c-line);
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: var(--c-text-2);
  font-size: var(--fs-base);
}

.row-value {
  color: var(--c-text);
  font-size: var(--fs-base);
  font-weight: 500;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: var(--fs-xs);
  line-height: 1.4;
  padding: 4rpx 14rpx;
  border-radius: var(--r-sm);
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.tag-green {
  background: var(--c-green-bg);
  color: var(--c-green-dark);
}

.tag-amber {
  background: var(--c-amber-bg);
  color: var(--c-amber-ink);
}

.tag-red {
  background: var(--c-red-bg);
  color: var(--c-red);
}

.tag-blue {
  background: var(--c-blue-bg);
  color: var(--c-blue);
}

.tag-grey {
  background: var(--c-muted);
  color: var(--c-text-2);
}

/* 「常见致敏」标记：中性描边，不做成红色警示（过敏原不等于危险，见指南准则二） */
.tag-outline {
  background: transparent;
  color: var(--c-text-3);
  border: 1rpx solid var(--c-line);
}

/* 按钮 */
.btn {
  display: block;
  width: 100%;
  padding: 26rpx 0;
  border-radius: var(--r-lg);
  font-size: var(--fs-lg);
  font-weight: 500;
  text-align: center;
  background: var(--c-muted);
  color: var(--c-text);
  border: none;
  line-height: 1.4;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--c-green);
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: var(--c-text-2);
  border: 1rpx solid var(--c-line);
}

/* 搜索框（全局统一：置于页面底色上时加 .search--card） */
.search {
  display: flex;
  align-items: center;
  background: var(--c-muted);
  border-radius: var(--r-md);
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.search--card {
  background: #ffffff;
}

.search-input {
  flex: 1;
  font-size: var(--fs-base);
  padding: 22rpx 0;
  color: var(--c-text);
}

.search-clear {
  font-size: var(--fs-md);
  color: var(--c-text-3);
  padding-left: 16rpx;
}

/* 空状态 */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--c-text-3);
  font-size: var(--fs-md);
}

/* 免责声明 */
.disclaimer {
  font-size: var(--fs-xs);
  color: var(--c-text-3);
  line-height: 1.7;
  padding: 24rpx 8rpx 0;
}

/* 分割 */
.divider {
  height: 1rpx;
  background: var(--c-line);
  margin: 20rpx 0;
}
